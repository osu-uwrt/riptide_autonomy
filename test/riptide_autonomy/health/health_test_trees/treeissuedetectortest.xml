<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

  <BehaviorTree ID="simplegoodtree">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="recursiontesttree">
    <Sequence>
      <Fallback>
        <AlwaysFailure/>
        <AlwaysFailure/>
        <AlwaysSuccess/>
        <AlwaysFailure/>
      </Fallback>
      <Inverter>
        <Script/> <!--should cause error-->
      </Inverter>
      <AlwaysSuccess/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="complexgoodtree">
    <Sequence>
      <Info message="a"/>
      <ForceSuccess>
        <AlwaysSuccess/>
      </ForceSuccess>
      <IfThenElse>
        <Fallback>
          <AlwaysFailure/>
          <Script code="aa:=5"/>
        </Fallback>
        <Script code="b:=3"/>
        <Script code="b:=6"/>
      </IfThenElse>
      <Info message="{aa}"/>
      <Info message="{b}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Info"
            editable="true">
      <input_port name="message"/>
    </Action>
  </TreeNodesModel>

</root>
