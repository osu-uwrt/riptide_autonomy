<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/CheckActuatorStates.xml"/>
    <include path="lib/SetActuatorsArmed.xml"/>
    <include path="lib/FireTorpedo.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <SubTree ID="CheckActuatorStates"/>
            <SubTree ID="SetActuatorsArmed" armed="1"/>
            <Repeat num_cycles="3">
                <ForceSuccess>
                    <SubTree ID="FireTorpedo"/>
                </ForceSuccess>
            </Repeat>
            <SubTree ID="SetActuatorsArmed" armed="0"/>
        </Sequence>
    </BehaviorTree>
</root>
