<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/RandomPingerTree.xml"/>
    <include path="lib/SurfaceTree.xml"/>
    <include path="lib/TorpedoTree.xml"/>
    <include path="lib/BinTree.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <Sequence name="MISSION">
            <SetBlackboardV3 output_key="1" value="1"/>
            <SetBlackboardV3 output_key="0" value="0"/>
            <Info message="MISSION: RESCUE"/>
            <ForceSuccess>
                <SubTree ID="RandomPingerTree" is_table="{{pinger_is_table}}"/>
            </ForceSuccess>
            <SetBlackboardV3 output_key="target_image" value="buoy"/>
            <IfThenElse>
                <Inverter>
                    <CompareNums a="{pinger_is_table}" b="0" test="=="/>
                </Inverter>
                <Sequence>
                    <ForceSuccess>
                        <SubTree ID="SurfaceTree" target_image="{target_image}"/>
                    </ForceSuccess>
                    <ForceSuccess>
                        <SubTree ID="TorpedoTree" repair_mission="{0}"/>
                    </ForceSuccess>
                </Sequence>
                <Sequence>
                    <ForceSuccess>
                        <SubTree ID="TorpedoTree" repair_mission="{0}"/>
                    </ForceSuccess>
                    <ForceSuccess>
                        <SubTree ID="SurfaceTree" target_image="{target_image}"/>
                    </ForceSuccess>
                </Sequence>
            </IfThenElse>
            <ForceSuccess>
                <Sequence>
                    <SubTree ID="BinTree" repair_mission="{0}"/>
                </Sequence>
            </ForceSuccess>
        </Sequence>
    </BehaviorTree>
</root>
