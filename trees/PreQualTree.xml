<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/WaitForKillSwitch.xml"/>
    <include path="lib/Dive.xml"/>
    <include path="lib/RelativeMove.xml"/>
    <include path="lib/Move.xml"/>
    <include path="lib/KillController.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <Sequence name="PREQUAL">
            <SetBlackboardV3 output_key="3" value="3"/>
            <SetBlackboardV3 output_key="2" value="2"/>
            <SetBlackboardV3 output_key="pole_radius" value="3"/>
            <SetBlackboardV3 output_key="-0.5" value="-0.5"/>
            <SetBlackboardV3 output_key="1" value="1"/>
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetBlackboardV3 output_key="gate_frame" value="prequal_gate_frame"/>
            <SetBlackboardV3 output_key="pole_frame" value="prequal_pole_frame"/>
            <SetBlackboardV3 output_key="-1" value="-1"/>
            <SetBlackboardV3 output_key="3.1415" value="3.1415"/>
            <SetBlackboardV3 output_key="-1.5707" value="-1.5707"/>
            <SubTree ID="WaitForKillSwitch"/>
            <SetStatus status="moving"/>
            <SubTree ID="Dive" depth="{-1}"/>
            <Sequence name="GATE 1">
                <Info message="GATE"/>
                <SetStatus status="aligning"/>
                <SubTree ID="RelativeMove" frame_name="{gate_frame}" op="{0}" or="{0}" oy="{3.1415}" x="{1}" y="{0}" z="{0}"/>
                <SetStatus status="performing"/>
                <SubTree ID="RelativeMove" frame_name="{gate_frame}" op="{0}" or="{0}" oy="{3.1415}" x="{-1}" y="{0}" z="{0}"/>
            </Sequence>
            <GetOdometry op="{op}" or="{or}" oy="{oy}" x="{x}" y="{y}" z="{z}"/>
            <TransformPose from_frame="{pole_frame}" op="0" or="0" out_op="{__v3_empty}" out_or="{__v3_empty}" out_oy="{__v3_empty}" out_x="{__v3_empty}" out_y="{__v3_empty}" out_z="{pole_depth}" oy="0" to_frame="world" x="0" y="0" z="0"/>
            <SubTree ID="Move" op="{0}" or="{0}" oy="{oy}" x="{x}" y="{y}" z="{pole_depth}"/>
            <Sequence name="POLE">
                <Info message="POLE TIME"/>
                <SetStatus status="moving"/>
                <SubTree ID="RelativeMove" frame_name="{pole_frame}" op="{0}" or="{0}" oy="{3.1415}" x="{pole_radius}" y="{0}" z="{0}"/>
                <SetStatus status="performing"/>
                <SubTree ID="RelativeMove" frame_name="{pole_frame}" op="{0}" or="{0}" oy="{3.1415}" x="{0}" y="{pole_radius}" z="{0}"/>
                <Math a="{pole_radius}" b="-1" operator="*" out="{neg_pole_radius}"/>
                <SubTree ID="RelativeMove" frame_name="{pole_frame}" op="{0}" or="{0}" oy="{3.1415}" x="{neg_pole_radius}" y="{0}" z="{0}"/>
                <SubTree ID="RelativeMove" frame_name="{pole_frame}" op="{0}" or="{0}" oy="{3.1415}" x="{0}" y="{neg_pole_radius}" z="{0}"/>
                <SubTree ID="RelativeMove" frame_name="{pole_frame}" op="{0}" or="{0}" oy="{0}" x="{pole_radius}" y="{0}" z="{0}"/>
            </Sequence>
            <Sequence name="GATE TIME 2">
                <SetStatus status="moving"/>
                <Info message="GATE TIME 2 ELECTRIC BOOGALOO"/>
                <TransformPose from_frame="{gate_frame}" op="0" or="0" out_op="{op}" out_or="{or}" out_oy="{oy}" out_x="{x}" out_y="{y}" out_z="{z}" oy="0" to_frame="world" x="-1" y="0" z="0"/>
                <SubTree ID="Move" op="{op}" or="{or}" oy="{oy}" x="{x}" y="{y}" z="{pole_depth}"/>
                <SetStatus status="aligning"/>
                <SubTree ID="RelativeMove" frame_name="{gate_frame}" op="{0}" or="{0}" oy="{0}" x="{-1}" y="{0}" z="{0}"/>
                <SetStatus status="performing"/>
                <SubTree ID="RelativeMove" frame_name="{gate_frame}" op="{0}" or="{0}" oy="{0}" x="{3}" y="{0}" z="{0}"/>
            </Sequence>
            <SubTree ID="KillController"/>
        </Sequence>
    </BehaviorTree>
</root>
