<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/WaitForKillSwitch.xml"/>
    <include path="lib/Dive.xml"/>
    <include path="lib/GateTree.xml"/>
    <include path="lib/SlalomTree.xml"/>
    <include path="lib/KillController.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <SetBlackboardV3 output_key="repair_mission" value="0"/>
            <SetBlackboardV3 output_key="1" value="1"/>
            <SetBlackboardV3 output_key="depth" value="-0.75"/>
            <SubTree ID="WaitForKillSwitch"/>
            <SubTree ID="Dive" depth="{depth}"/>
            <SubTree ID="GateTree" repair_mission="{repair_mission}" sla_pass_on_left="{pass_on_left}"/>
            <SubTree ID="SlalomTree" pass_on_left="{pass_on_left}"/>
            <SubTree ID="KillController"/>
        </Sequence>
    </BehaviorTree>
</root>
