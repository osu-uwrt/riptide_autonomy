            <input_port name="lock_map" required="true"/>
            <input_port name="target_object" required="false"/>
            <input_port name="time_limit_secs" required="true"/>
        </Action>
        <Action ID="SetStatus">
            <input_port name="status" required="true"/>
        </Action>
        <SubTree ID="SetWinchState">
            <input_port default="false" name="__shared_blackboard" required="false">If false (default), the Subtree has an isolated blackboard and needs port remapping</input_port>
            <input_port name="winch_extended" required="true"/>
        </SubTree>
        <SubTree ID="ShootDownwardObject">
            <input_port default="false" name="__shared_blackboard" required="false">If false (default), the Subtree has an isolated blackboard and needs port remapping</input_port>
            <input_port name="dropper_link_name" required="true"/>
            <input_port name="object_name" required="true"/>
            <input_port name="search_prox" required="true"/>
        </SubTree>
        <SubTree ID="ShootObject">
            <input_port default="false" name="__shared_blackboard" required="false">If false (default), the Subtree has an isolated blackboard and needs port remapping</input_port>
            <input_port name="object_name" required="true"/>
            <input_port default="talos/torpedo_link" name="torpedo_link_name" required="true"/>
            <input_port default="torpedo" name="torpedo_name" required="true"/>
        </SubTree>
        <SubTree ID="SingleSlalom">
            <input_port default="false" name="__shared_blackboard" required="false">If false (default), the Subtree has an isolated blackboard and needs port remapping</input_port>
            <input_port name="pass_on_left" required="true">Whether to pass on the left side of the red slalom pole</input_port>
            <input_port name="slalom_type" required="true">The mapping type of slalom to search for</input_port>
        </SubTree>
        <SubTree ID="SlalomTree">
            <input_port default="false" name="__shared_blackboard" required="false">If false (default), the Subtree has an isolated blackboard and needs port remapping</input_port>
            <input_port name="pass_on_left" required="true"/>
