<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="MiniSearchMpc.xml"/>
    <include path="ActivateMagnetMpc.xml"/>
    <BehaviorTree ID="MagnetTreeMpc">
        <Sequence>
            <SetBlackboardV3 output_key="3.14159" value="3.14159"/>
            <SetBlackboardV3 output_key="bin_move_height" value="-0.8"/>
            <SetBlackboardV3 output_key="object_vision_class" value="magnet"/>
            <SetBlackboardV3 output_key="search_timeout" value="20"/>
            <SetBlackboardV3 output_key="search_target_cov" value="1.25"/>
            <SetBlackboardV3 output_key="search_prox_x" value="1.0"/>
            <SetBlackboardV3 output_key="search_prox_z" value="0.2"/>
            <SetBlackboardV3 output_key="magnet1" value="magnet_target1"/>
            <SetBlackboardV3 output_key="magnet2" value="magnet_target2"/>
            <SetBlackboardV3 output_key="magnet1_frame" value="magnet_target1_frame"/>
            <SetBlackboardV3 output_key="magnet2_frame" value="magnet_target2_frame"/>
            <SetBlackboardV3 output_key="m1_retreat" value=";"/>
            <SetBlackboardV3 output_key="base_link_frame" value="talos/base_link"/>
            <SetBlackboardV3 output_key="still_dist" value="1"/>
            <SetBlackboardV3 output_key="still_trust" value="0.8"/>
            <SetBlackboardV3 output_key="still_timeout" value="15"/>
            <SetBlackboardV3 output_key="m2_retreat" value=";"/>
            <ForceSuccess>
                <CallSetStringService data="{bin_object_vision_class}" srv_name="/talos/mapping/fit_bin_geometry" time_limit_secs="3"/>
            </ForceSuccess>
            <RetryUntilSuccessfulV3 num_attempts="3">
                <CallStartBinaryClassifierService class_name="{object_vision_class}" object1_name="{magnet1}" object2_name="{magnet2}" srv_name="/talos/mapping/start_binary_classifier" time_limit_secs="3"/>
            </RetryUntilSuccessfulV3>
            <ForceSuccess>
                <Sequence>
                    <SubTree ID="SetActiveCamera" is_dfc="{0}"/>
                    <TransformPose from_frame="{magnet1_frame}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="3.14159" to_frame="world" x="{search_prox_x}" y="0" z="0"/>
                    <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="magnet 1 search spot" out="{magnet_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{ax}" y="{ay}" yaw="{aoy}" yaw_offset="" z="{bin_move_height}"/>
                    <FollowPath frame="" max_depth="-2.5" min_depth="-0.75" name="To magnet 1 search spot" spin_rate="" timeout="60" waypoints="{magnet_path}"/>
                    <SubTree ID="MiniSearchMpc" object_name="{magnet1}" parent_object="{magnet1}" prox_x="{search_prox_x}" prox_y="{0}" prox_z="{search_prox_z}" target_cov="{search_target_cov}" timeout_secs="{search_timeout}"/>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <RetryUntilSuccessfulV3 num_attempts="3">
                    <CallTriggerService srv_name="/talos/mapping/freeze_binary_classifier_buffer" time_limit_secs="3"/>
                </RetryUntilSuccessfulV3>
            </ForceSuccess>
            <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
            <SubTree ID="ActivateMagnetMpc" magnet_frame="{magnet1_frame}" retreat_path="{m1_retreat}"/>
            <ForceSuccess>
                <RetryUntilSuccessfulV3 num_attempts="3">
                    <CallTriggerService srv_name="/talos/mapping/start_binary_classifier_second" time_limit_secs="3"/>
                </RetryUntilSuccessfulV3>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <TransformPose from_frame="{magnet2_frame}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="3.14159" to_frame="world" x="{search_prox_x}" y="0" z="0"/>
                    <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="magnet 2 search spot" out="{magnet_path}" path="{m1_retreat}" pitch="" roll="" spin="" spin_rate="" x="{bx}" y="{by}" yaw="{boy}" yaw_offset="" z="{bin_move_height}"/>
                    <FollowPath frame="" max_depth="-2.5" min_depth="-0.75" name="Retreat from magnet 1, on to the magnet 2 search spot" spin_rate="" timeout="90" waypoints="{magnet_path}"/>
                    <SubTree ID="MiniSearchMpc" object_name="{magnet2}" parent_object="{magnet2}" prox_x="{search_prox_x}" prox_y="{0}" prox_z="{search_prox_z}" target_cov="{search_target_cov}" timeout_secs="{search_timeout}"/>
                </Sequence>
            </ForceSuccess>
            <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
            <SubTree ID="ActivateMagnetMpc" magnet_frame="{magnet2_frame}" retreat_path="{m2_retreat}"/>
            <ForceSuccess>
                <Sequence>
                    <TransformPose from_frame="{magnet2_frame}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="3.14159" to_frame="world" x="{search_prox_x}" y="0" z="0"/>
                    <GetOdometry op="{__v3_empty}" or="{__v3_empty}" oy="{cur_yaw}" x="{__v3_empty}" y="{__v3_empty}" z="{__v3_empty}"/>
                    <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="magnet 2 search spot" out="{magnet_path}" path="{m2_retreat}" pitch="" roll="" spin="" spin_rate="" x="{bx}" y="{by}" yaw="{cur_yaw}" yaw_offset="" z="{bin_move_height}"/>
                    <FollowPath frame="" max_depth="-2.5" min_depth="-0.75" name="Retreat from magnet 2 to its search spot" spin_rate="" timeout="90" waypoints="{magnet_path}"/>
                </Sequence>
            </ForceSuccess>
        </Sequence>
    </BehaviorTree>
</root>
