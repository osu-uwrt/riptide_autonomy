<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID="GetOppositeColorBasket">
        <Sequence>
            <Fallback>
                <Precondition if="obj == 'table_spoon_pink'" else="FAILURE">
                    <SetBlackboardV3 output_key="out" value="table_basket_yellow"/>
                </Precondition>
                <Precondition if="obj == 'table_basket_pink'" else="FAILURE">
                    <SetBlackboardV3 output_key="out" value="table_basket_yellow"/>
                </Precondition>
                <Precondition if="obj == 'table_bottle_yellow'" else="FAILURE">
                    <SetBlackboardV3 output_key="out" value="table_basket_pink"/>
                </Precondition>
                <Precondition if="obj == 'table_basket_yellow'" else="FAILURE">
                    <SetBlackboardV3 output_key="out" value="table_basket_pink"/>
                </Precondition>
                <ForceFailure>
                    <Error message="Unable to find basket color for object {obj}!"/>
                </ForceFailure>
            </Fallback>
            <Format format="{out}_frame" out="{out_frame}"/>
        </Sequence>
    </BehaviorTree>
</root>
