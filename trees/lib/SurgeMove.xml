<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="RotateToFrame.xml"/>
    <BehaviorTree ID="SurgeMove">
        <Sequence name="SurgeMove">
            <GetMappingState map_locked="{__v3_empty}" target_name="{target_object}"/>
            <Format format="{target_object}_frame" name="get frame from obj" out="{target_object_frame}"/>
            <Info message="Controlling surge to {x} relative to target map object {target_object}, at depth {z}."/>
            <SetBlackboardV3 output_key="error" value="0"/>
            <Fallback>
                <Parallel failure_count="1" success_count="1">
                    <RetryUntilSuccessfulOrTimeout name="Never-ending rotation loop" num_seconds="{timeout}">
                        <ForceFailure>
                            <Sequence>
                                <SetBlackboardV3 output_key="0" value="0"/>
                                <SubTree ID="RotateToFrame" relative_yaw="{0}" target_frame="{target_object_frame}"/>
                                <Wait seconds="1"/>
                            </Sequence>
                        </ForceFailure>
                    </RetryUntilSuccessfulOrTimeout>
                    <Sequence>
                        <RetryUntilSuccessfulOrTimeout name="Linear loop" num_seconds="{timeout}">
                            <Sequence name="Attempt to control surge">
                                <SetBlackboardV3 output_key="no_track_counter" value="0"/>
                                <Fallback name="Try move and eval tracking">
                                    <RetryUntilSuccessfulV3 num_attempts="5">
                                        <Sequence>
                                            <Wait seconds="0.25"/>
                                            <PublishToController isOrientation="0" mode="3" x="{x}" y="0" z="{z}"/>
                                            <GetOdometry op="{__v3_empty}" or="{__v3_empty}" oy="{__v3_empty}" x="{__v3_empty}" y="{__v3_empty}" z="{cz}"/>
                                            <GetFloat64Topic topic="controller/surge/reference/filtered" value="{cx}"/>
                                            <GetBoolTopic topic="controller/surge/tracking" value="{tracking}"/>
                                            <Fallback name="Check tracking">
                                                <IsTrue name="is controller tracking the object?" value="{tracking}"/>
                                                <ForceFailure>
                                                    <Sequence>
                                                        <Math a="{no_track_counter}" b="1" name="no, increment counter" operator="+" out="{no_track_counter}"/>
                                                        <Info message="Surge lost tracking! Incremented counter (now {no_track_counter})"/>
                                                    </Sequence>
                                                </ForceFailure>
                                            </Fallback>
                                            <ApproxEqualTo a="{cz}" b="{z}" range="0.25"/>
                                            <ApproxEqualTo a="{cx}" b="{x}" range="0.05"/>
                                        </Sequence>
                                    </RetryUntilSuccessfulV3>
                                    <ForceFailure>
                                        <Info message="Surge is currently at {cx} (want {x})" name="Report current surge"/>
                                    </ForceFailure>
                                    <Inverter>
                                        <Fallback>
                                            <Inverter name="Was tracking lost?">
                                                <CompareNums a="{no_track_counter}" b="3" name="Was tracking good?" test="&gt;"/>
                                            </Inverter>
                                            <ForceFailure>
                                                <Sequence>
                                                    <Error message="Surge move failed because tracking was lost."/>
                                                    <SetBlackboardV3 name="This will succeed but then tree will report error" output_key="error" value="1"/>
                                                </Sequence>
                                            </ForceFailure>
                                        </Fallback>
                                    </Inverter>
                                </Fallback>
                            </Sequence>
                        </RetryUntilSuccessfulOrTimeout>
                        <Inverter>
                            <CompareNums a="{error}" b="0.1" name="Error in surge tree?" test="&gt;"/>
                        </Inverter>
                        <Info message="Successfully moved surge to setpoint x={x}, z={z}"/>
                    </Sequence>
                </Parallel>
                <ForceFailure>
                    <Error message="Couldn't move surge to desired setpoint. Wanted x={x}, z={z}; got x={cx}, z={cz}."/>
                </ForceFailure>
            </Fallback>
        </Sequence>
    </BehaviorTree>
</root>
