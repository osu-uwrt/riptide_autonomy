        </Action>
        <SubTree ID="FireDropper"/>
        <SubTree ID="FireTorpedo"/>
        <SubTree ID="FlipTree">
            <input_port name="undergate_depth"/>
        </SubTree>
        <Action ID="FollowPath">
            <input_port name="frame" type="BT::AnyTypeAllowed">Frame of waypoints without their own (default world)</input_port>
            <input_port name="max_depth" type="BT::AnyTypeAllowed">Deepest allowed z in world (default -4)</input_port>
            <input_port name="max_speed" type="BT::AnyTypeAllowed">Cruise speed cap for this path, m/s (default 0: the controller's own limit)</input_port>
            <input_port name="min_depth" type="BT::AnyTypeAllowed">Shallowest allowed z in world (default -0.55)</input_port>
            <input_port name="spin_rate" type="BT::AnyTypeAllowed">Steady spin for the whole path, rad per metre (about rad/s / cruise speed; default 0)</input_port>
            <input_port name="timeout" type="BT::AnyTypeAllowed">Seconds before giving up (default 60)</input_port>
            <input_port name="waypoints" type="BT::AnyTypeAllowed">"x,y,z,yaw; frame: x,y,z,yaw | arc=cx,cy,sweep; ..." (or x,y,z,roll,pitch,yaw); {blackboard} references allowed</input_port>
        </Action>
        <Action ID="Format">
            <input_port name="format" type="BT::AnyTypeAllowed"/>
            <output_port name="out" type="std::string"/>
        </Action>
        <SubTree ID="GateTree">
