<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <TreeNodesModel>
        <SubTree ID="ActivateMagnet">
            <input_port name="magnet_frame"/>
        </SubTree>
        <SubTree ID="ActivateMagnetMpc">
            <input_port name="magnet_frame"/>
            <output_port name="retreat_path" type="std::string">Waypoints back to pre-align and up; empty if alignment failed</output_port>
        </SubTree>
        <Action ID="AddArc">
            <input_port name="approach" type="BT::AnyTypeAllowed">false: start from the previous point, no line to the arc (default true)</input_port>
            <input_port name="cx" type="BT::AnyTypeAllowed">Centre x in frame</input_port>
            <input_port name="cy" type="BT::AnyTypeAllowed">Centre y in frame</input_port>
            <input_port name="end_radius" type="BT::AnyTypeAllowed">Radius at the end (default radius; differs = spiral)</input_port>
            <input_port name="frame" type="BT::AnyTypeAllowed">Frame of the centre and angles (default: FollowPath's frame)</input_port>
            <input_port name="heading" type="BT::AnyTypeAllowed">waypoint (default), path (face travel) or look_at; also the approach line's</input_port>
            <input_port name="look_frame" type="BT::AnyTypeAllowed">Face this TF frame, followed live as it moves (sets heading look_at)</input_port>
            <input_port name="look_x" type="BT::AnyTypeAllowed">look_at point in frame (default: the centre), or in look_frame (default 0)</input_port>
            <input_port name="look_y" type="BT::AnyTypeAllowed">look_at point in frame (default: the centre), or in look_frame (default 0)</input_port>
            <input_port name="look_z" type="BT::AnyTypeAllowed">look_at point in frame (default: z), or in look_frame (default 0)</input_port>
            <output_port name="out" type="std::string">Path with the arc appended</output_port>
            <input_port name="pan" type="BT::AnyTypeAllowed">Swing the heading this far each way along the arc (rad, needs heading path or look_at; default 0)</input_port>
            <input_port name="pan_step" type="BT::AnyTypeAllowed">Arc per pan piece (rad, default 0.25)</input_port>
            <input_port name="path" type="BT::AnyTypeAllowed">Waypoints so far (leave empty to start a new path)</input_port>
            <input_port name="radius" type="BT::AnyTypeAllowed"/>
            <input_port name="spin" type="BT::AnyTypeAllowed">Extra yaw over the arc, 6.283 = one turn (default 0)</input_port>
            <input_port name="spin_rate" type="BT::AnyTypeAllowed">Steady spin on the arc, rad per metre (default 0)</input_port>
            <input_port name="start_angle" type="BT::AnyTypeAllowed">Where the arc starts, from the frame's +x (rad)</input_port>
            <input_port name="sweep" type="BT::AnyTypeAllowed">How far round (rad, + = counterclockwise from above)</input_port>
            <input_port name="yaw" type="BT::AnyTypeAllowed">End yaw for heading waypoint (default 0)</input_port>
            <input_port name="yaw_frame" type="BT::AnyTypeAllowed">End yaw is in this frame instead of frame (e.g. world)</input_port>
            <input_port name="yaw_offset" type="BT::AnyTypeAllowed">Added to path / look_at yaw (default 0)</input_port>
            <input_port name="z" type="BT::AnyTypeAllowed">Depth in frame</input_port>
        </Action>
        <Action ID="AddWaypoint">
            <input_port name="frame" type="BT::AnyTypeAllowed">Frame of this waypoint (default: FollowPath's frame)</input_port>
            <input_port name="heading" type="BT::AnyTypeAllowed">waypoint (default: blend to yaw), path (face travel) or look_at</input_port>
            <input_port name="look_frame" type="BT::AnyTypeAllowed">Face this TF frame, followed live as it moves (sets heading look_at)</input_port>
            <input_port name="look_x" type="BT::AnyTypeAllowed">look_at point in frame, or in look_frame (default 0)</input_port>
            <input_port name="look_y" type="BT::AnyTypeAllowed">look_at point in frame, or in look_frame (default 0)</input_port>
            <input_port name="look_z" type="BT::AnyTypeAllowed">look_at point in frame, or in look_frame (default 0)</input_port>
            <output_port name="out" type="std::string">Path with this waypoint appended</output_port>
            <input_port name="path" type="BT::AnyTypeAllowed">Waypoints so far (leave empty to start a new path)</input_port>
            <input_port name="pitch" type="BT::AnyTypeAllowed">Pitch at this waypoint (default 0)</input_port>
            <input_port name="roll" type="BT::AnyTypeAllowed">Roll at this waypoint (default 0)</input_port>
            <input_port name="spin" type="BT::AnyTypeAllowed">Extra yaw over this leg, 6.283 = one turn (default 0)</input_port>
            <input_port name="spin_rate" type="BT::AnyTypeAllowed">Steady spin on this leg, rad per metre (default 0)</input_port>
            <input_port name="x" type="BT::AnyTypeAllowed"/>
            <input_port name="y" type="BT::AnyTypeAllowed"/>
            <input_port name="yaw" type="BT::AnyTypeAllowed">End yaw for heading waypoint (default 0)</input_port>
            <input_port name="yaw_frame" type="BT::AnyTypeAllowed">roll/pitch/yaw are in this frame instead of frame (e.g. world: hold a world heading)</input_port>
            <input_port name="yaw_offset" type="BT::AnyTypeAllowed">Added to path / look_at yaw (default 0)</input_port>
            <input_port name="z" type="BT::AnyTypeAllowed"/>
        </Action>
        <SubTree ID="AlignLink">
            <input_port name="frame_name">frame to align to</input_port>
            <input_port name="link_name">link to align</input_port>
            <input_port name="prox_x" default="1">default x promity</input_port>
            <input_port name="prox_z" default="0">default z proximity</input_port>
        </SubTree>
        <SubTree ID="AlignLinkPositionOnly">
            <input_port name="frame_name"/>
            <input_port name="link_name"/>
            <input_port name="x"/>
            <input_port name="y"/>
            <input_port name="z"/>
        </SubTree>
        <Condition ID="ApproxEqualTo">
            <input_port name="a" type="BT::AnyTypeAllowed"/>
            <input_port name="b" type="BT::AnyTypeAllowed"/>
            <input_port name="range" type="BT::AnyTypeAllowed"/>
        </Condition>
        <Condition ID="ApproxEqualToAngle">
            <input_port name="a" type="BT::AnyTypeAllowed"/>
            <input_port name="b" type="BT::AnyTypeAllowed"/>
            <input_port name="range" type="BT::AnyTypeAllowed"/>
        </Condition>
        <SubTree ID="AssertTree">
            <input_port name="a"/>
            <input_port name="aname"/>
            <input_port name="b"/>
            <input_port name="test">Same as CompareNums</input_port>
        </SubTree>
        <SubTree ID="BinTree">
            <input_port name="repair_mission"/>
        </SubTree>
        <SubTree ID="BinTreeMpc">
            <input_port name="repair_mission"/>
        </SubTree>
        <Decorator ID="BlackboardCheckString">
            <input_port name="return_on_mismatch" type="std::string">Status when value_A != value_B</input_port>
            <input_port name="value_A" type="std::string"/>
            <input_port name="value_B" type="std::string"/>
        </Decorator>
        <SubTree ID="BuoyTree"/>
        <Action ID="CalculateDistance">
            <output_port name="dist" type="std::string"/>
            <input_port name="x1" type="BT::AnyTypeAllowed"/>
            <input_port name="x2" type="BT::AnyTypeAllowed"/>
            <input_port name="y1" type="BT::AnyTypeAllowed"/>
            <input_port name="y2" type="BT::AnyTypeAllowed"/>
            <input_port name="z1" type="BT::AnyTypeAllowed"/>
            <input_port name="z2" type="BT::AnyTypeAllowed"/>
        </Action>
        <Action ID="CallSetBoolService">
            <input_port name="data" type="BT::AnyTypeAllowed"/>
            <input_port name="srv_name" type="BT::AnyTypeAllowed"/>
            <input_port name="time_limit_secs" type="BT::AnyTypeAllowed"/>
        </Action>
        <Action ID="CallSetStringService">
            <input_port name="data" type="BT::AnyTypeAllowed"/>
            <input_port name="srv_name" type="BT::AnyTypeAllowed"/>
            <input_port name="time_limit_secs" type="BT::AnyTypeAllowed"/>
        </Action>
        <Action ID="CallStartBinaryClassifierService">
            <input_port name="class_name" type="BT::AnyTypeAllowed"/>
            <input_port name="object1_name" type="BT::AnyTypeAllowed"/>
            <input_port name="object2_name" type="BT::AnyTypeAllowed"/>
            <input_port name="srv_name" type="BT::AnyTypeAllowed"/>
            <input_port name="time_limit_secs" type="BT::AnyTypeAllowed"/>
        </Action>
        <Action ID="CallTriggerService">
            <input_port name="srv_name" type="BT::AnyTypeAllowed"/>
            <input_port name="time_limit_secs" type="BT::AnyTypeAllowed"/>
        </Action>
        <Action ID="CenterDetection">
            <input_port name="align_tolerance" type="BT::AnyTypeAllowed">Square on within this (rad); default 0.08</input_port>
            <input_port name="align_yaw" type="BT::AnyTypeAllowed">Move square on to the object (its frame's yaw); false: turn in place; default true</input_port>
            <input_port name="base_frame" type="BT::AnyTypeAllowed">Vehicle frame; default talos/base_link</input_port>
            <input_port name="center_depth" type="BT::AnyTypeAllowed">false: yaw only; default true</input_port>
            <input_port name="depth_tolerance" type="BT::AnyTypeAllowed">Level within this (m); default 0.1</input_port>
            <input_port name="max_age_secs" type="BT::AnyTypeAllowed">Lost once no detection is this old; default 1.5</input_port>
            <input_port name="max_depth" type="BT::AnyTypeAllowed">Deepest depth to move to; default -2.5</input_port>
            <input_port name="min_depth" type="BT::AnyTypeAllowed">Shallowest depth to move to; default -0.75</input_port>
            <input_port name="min_score" type="BT::AnyTypeAllowed">Ignore weaker detections; default 0.2</input_port>
            <input_port name="object_frame" type="BT::AnyTypeAllowed">Frame whose yaw to align with; default &lt;object_name&gt;_frame</input_port>
            <input_port name="object_name" type="BT::AnyTypeAllowed">Detector class to center</input_port>
            <input_port name="position_tolerance" type="BT::AnyTypeAllowed">There within this (m); default 0.1</input_port>
            <input_port name="standoff" type="BT::AnyTypeAllowed">Camera distance in front of it (m); default the range it was seen from</input_port>
            <input_port name="timeout_secs" type="BT::AnyTypeAllowed">Give up after; default 8</input_port>
            <input_port name="yaw_tolerance" type="BT::AnyTypeAllowed">Centered within this (rad); default 0.05</input_port>
        </Action>
        <SubTree ID="CheckActuatorStates"/>
        <Action ID="CheckBlackboardExists">
            <input_port name="input" type="BT::AnyTypeAllowed"/>
        </Action>
        <SubTree ID="CollectDets">
            <input_port name="target"/>
            <input_port name="target_error"/>
        </SubTree>
        <SubTree ID="CollectDetsAtAngle">
            <input_port name="frame"/>
            <input_port name="rel_yaw"/>
            <input_port name="target"/>
            <input_port name="target_error"/>
        </SubTree>
        <SubTree ID="CompLiteMissionTree">
            <input_port name="repair_mission"/>
        </SubTree>
        <SubTree ID="CompMissionTree">
            <input_port name="repair_mission"/>
        </SubTree>
        <SubTree ID="CompMissionTreeMpc">
            <input_port name="repair_mission"/>
        </SubTree>
        <Condition ID="CompareNums">
            <input_port name="a" type="BT::AnyTypeAllowed"/>
