            <input_port name="op" type="BT::AnyTypeAllowed"/>
            <input_port name="or" type="BT::AnyTypeAllowed"/>
            <output_port name="out_op" type="std::string"/>
            <output_port name="out_or" type="std::string"/>
            <output_port name="out_oy" type="std::string"/>
            <output_port name="out_x" type="std::string"/>
            <output_port name="out_y" type="std::string"/>
            <output_port name="out_z" type="std::string"/>
            <input_port name="oy" type="BT::AnyTypeAllowed"/>
            <input_port name="reference_frame" type="BT::AnyTypeAllowed"/>
            <input_port name="x" type="BT::AnyTypeAllowed"/>
            <input_port name="y" type="BT::AnyTypeAllowed"/>
            <input_port name="z" type="BT::AnyTypeAllowed"/>
        </Action>
        <Action ID="ContinuousSpin">
            <input_port name="num_cycles" type="BT::AnyTypeAllowed">Number of full counterclockwise turns</input_port>
            <input_port name="odom_timeout_secs" type="BT::AnyTypeAllowed">Odometry watchdog; default 1 second</input_port>
            <input_port name="timeout_secs" type="BT::AnyTypeAllowed">Overall timeout; default 90 seconds</input_port>
            <input_port name="yaw_rate" type="BT::AnyTypeAllowed">Target ramp speed in radians/second; unset: as fast as the controller follows</input_port>
        </Action>
        <SubTree ID="DemoTableTree"/>
        <SubTree ID="DeployTankTree"/>
        <SubTree ID="DiscoverObjects">
            <input_port name="base_link"/>
            <output_port name="discovered_object" type="std::string"/>
