<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="PrimitiveMovePosition.xml"/>
    <include path="PrimitiveMoveOrientation.xml"/>
    <BehaviorTree ID="MiniSearchMpc">
        <Sequence name="minisearch with the forward camera, not base_link, at the search point">
            <SetBlackboardV3 output_key="15" value="15"/>
            <SetBlackboardV3 output_key="60" value="60"/>
            <SetBlackboardV3 output_key="1" value="1"/>
            <SetBlackboardV3 output_key="3.1415" value="3.1415"/>
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetBlackboardV3 name="Forward camera: it goes to the search point, facing the object" output_key="camera_link" value="talos/ffc_base_link"/>
            <Info message="Refining esimate for object {object_name}"/>
            <Format format="{parent_object}_frame" out="{parent_frame}"/>
            <Format format="{object_name}_frame" out="{object_frame}"/>
            <SetStatus status="searching"/>
            <TransformPose from_frame="{camera_link}" name="the camera's tilt now (kept, so the vehicle stays level)" op="0" or="0" out_op="{cam_pitch}" out_or="{cam_roll}" out_oy="{__v3_empty}" out_x="{__v3_empty}" out_y="{__v3_empty}" out_z="{__v3_empty}" oy="0" to_frame="{parent_frame}" x="0" y="0" z="0"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{camera_link}" name="camera at the search point, facing the object" op="{cam_pitch}" or="{cam_roll}" out_op="{__v3_empty}" out_or="{__v3_empty}" out_oy="{oy}" out_x="{x}" out_y="{y}" out_z="{z}" oy="3.1415" reference_frame="{parent_frame}" x="{prox_x}" y="{prox_y}" z="{prox_z}"/>
            <SubTree ID="PrimitiveMovePosition" timeout="{60}" x="{x}" y="{y}" z="{z}"/>
            <SubTree ID="PrimitiveMoveOrientation" p="{0}" r="{0}" timeout="{15}" y="{oy}"/>
            <SetMappingTarget lock_map="0" target_object="{object_name}" time_limit_secs="3"/>
            <Wait seconds="5"/>
            <RetryUntilSuccessfulOrTimeout num_seconds="{timeout_secs}">
                <Sequence name="shrink cov">
                    <Wait seconds="1"/>
                    <getCovariance Covariance="{cov}" Target="{object_name}"/>
                    <IfThenElse name="move in front of sub object if confident">
                        <CompareNums a="{cov}" b="0.1" name="if error good enough" test="&lt;"/>
                        <Sequence name="move in front of object">
                            <TransformPose from_frame="{camera_link}" name="the camera's tilt now (kept, so the vehicle stays level)" op="0" or="0" out_op="{cam_pitch}" out_or="{cam_roll}" out_oy="{__v3_empty}" out_x="{__v3_empty}" out_y="{__v3_empty}" out_z="{__v3_empty}" oy="0" to_frame="{parent_frame}" x="0" y="0" z="0"/>
                            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{camera_link}" name="camera straight in front of it" op="{cam_pitch}" or="{cam_roll}" out_op="{__v3_empty}" out_or="{__v3_empty}" out_oy="{new_yaw}" out_x="{new_x}" out_y="{new_y}" out_z="{new_z}" oy="3.1415" reference_frame="{parent_frame}" x="{prox_x}" y="0" z="{prox_z}"/>
                            <PublishToController isOrientation="0" mode="3" x="{new_x}" y="{new_y}" z="{new_z}"/>
                            <PublishToController isOrientation="1" mode="3" x="0" y="0" z="{new_yaw}"/>
                        </Sequence>
                        <AlwaysSuccess name="move in front of parent"/>
                    </IfThenElse>
                    <Info message="Object {object_name} has covariance {cov}"/>
                    <CompareNums a="{cov}" b="{target_cov}" test="&lt;"/>
                </Sequence>
            </RetryUntilSuccessfulOrTimeout>
        </Sequence>
    </BehaviorTree>
</root>
