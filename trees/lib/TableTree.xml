<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="TankLongitudinalFF.xml"/>
    <include path="RelativeMove.xml"/>
    <include path="GrabObject.xml"/>
    <include path="SetWinchState.xml"/>
    <include path="PrimitiveMovePosition.xml"/>
    <include path="GetOppositeColorBasket.xml"/>
    <include path="RotateToFrame.xml"/>
    <include path="GoToObject.xml"/>
    <include path="DiscoverObjects.xml"/>
    <include path="LockInObject.xml"/>
    <include path="SetClawState.xml"/>
    <BehaviorTree ID="TableTree">
        <Sequence>
            <Sequence name="Blackboards">
                <SetBlackboardV3 output_key="1" value="1"/>
                <SetBlackboardV3 output_key="0" value="0"/>
                <SetBlackboardV3 output_key="60" value="60"/>
                <SetBlackboardV3 output_key="1.5707" value="1.5707"/>
                <SetBlackboardV3 output_key="-1.5707" value="-1.5707"/>
                <SetBlackboardV3 output_key="-0.7853" value="-0.7853"/>
                <SetBlackboardV3 output_key="3.1415" value="3.1415"/>
                <SetBlackboardV3 output_key="num_sorts" value="0"/>
                <SetBlackboardV3 output_key="jump_depth" value="-1.4"/>
                <SetBlackboardV3 output_key="back_pwr" value="-0.2"/>
                <SetBlackboardV3 output_key="back_dur" value="2"/>
                <SetBlackboardV3 output_key="target_error" value="0.01"/>
                <SetBlackboardV3 output_key="base_link" value="liltank/base_link"/>
                <SetBlackboardV3 output_key="bin_pink" value="table_basket_pink"/>
                <SetBlackboardV3 output_key="bin_yellow" value="table_basket_yellow"/>
                <SetBlackboardV3 output_key="cup_yellow" value="table_bottle_yellow"/>
                <SetBlackboardV3 output_key="spoon_pink" value="table_spoon_pink"/>
            </Sequence>
            <Info message="TABLE TIME"/>
            <ForceSuccess>
                <RepeatV3 num_cycles="4">
                    <Sequence>
                        <Sequence>
                            <Info message="TABLE LOOP BEGIN"/>
                            <Sequence name="Table loop">
                                <RetryUntilSuccessfulV3 num_attempts="4">
                                    <Sequence name="Find and retrieve object">
                                        <Info message="Assuming object discovery position"/>
                                        <SubTree ID="TankLongitudinalFF" duration="{back_dur}" power="{back_pwr}"/>
                                        <SubTree ID="RelativeMove" frame_name="{base_link}" op="{0}" or="{0}" oy="{-1.5707}" x="{0}" y="{0}" z="{0}"/>
                                        <SubTree ID="TankLongitudinalFF" duration="{back_dur}" power="{back_pwr}"/>
                                        <Info message="Grabbing object between options {spoon_pink}, {cup_yellow}"/>
                                        <Fallback>
                                            <SubTree ID="GrabObject" discovered_target="{discovered_trash}" object_1="{spoon_pink}" object_2="{cup_yellow}" object_3="{__v3_empty}" object_4="{__v3_empty}" target_error="{target_error}"/>
                                            <ForceFailure>
                                                <SubTree ID="RelativeMove" frame_name="{base_link}" op="{0}" or="{0}" oy="{-1.5707}" x="{0}" y="{0}" z="{0}"/>
                                            </ForceFailure>
                                        </Fallback>
                                        <Info message="Object {discovered_trash} retrieved successfully."/>
                                    </Sequence>
                                </RetryUntilSuccessfulV3>
                                <Sequence name="Jump to surface">
                                    <Info message="Performing surface jump"/>
                                    <SubTree ID="SetWinchState" winch_extended="{1}"/>
                                    <SetMappingTarget lock_map="0" name="Clear target before jump" target_object="" time_limit_secs="3"/>
                                    <GetOdometry op="{p}" or="{r}" oy="{w}" x="{x}" y="{y}" z="{z}"/>
                                    <Info message="Ascending to surface"/>
                                    <SubTree ID="PrimitiveMovePosition" timeout="{60}" x="{0}" y="{0}" z="{jump_depth}"/>
                                    <Info message="Returning to depth Z={z}"/>
                                    <SubTree ID="PrimitiveMovePosition" timeout="{60}" x="{0}" y="{0}" z="{z}"/>
                                    <RepeatV3 num_cycles="5">
                                        <PublishToController isOrientation="0" mode="0" name="Disable position control" x="0" y="0" z="0"/>
                                    </RepeatV3>
                                    <Info message="Jump complete."/>
                                </Sequence>
                                <Sequence name="Deposit trash">
                                    <Info message="Depositing object into basket"/>
                                    <SubTree ID="GetOppositeColorBasket" obj="{discovered_trash}" out="{target_bin}" out_frame="{target_bin_frame}"/>
                                    <SubTree ID="GetOppositeColorBasket" obj="{target_bin}" out="{intermediate_bin}" out_frame="{intermediate_bin_frame}"/>
                                    <Info message="Possessed object is {discovered_trash}, target basket is {target_bin}, opposite basket is {intermediate_bin}"/>
                                    <SubTree ID="RotateToFrame" relative_yaw="{-0.7853}" target_frame="{intermediate_bin_frame}"/>
                                    <SubTree ID="GoToObject" discovered_object="{intermediate_bin}" object_1="{intermediate_bin}" object_2="{__v3_empty}" object_3="{__v3_empty}" object_4="{__v3_empty}" target_error="{target_error}"/>
                                    <SubTree ID="RelativeMove" frame_name="{base_link}" op="{0}" or="{0}" oy="{3.1415}" x="{0}" y="{0}" z="{0}"/>
                                    <RepeatV3 num_cycles="5">
                                        <PublishToController isOrientation="0" mode="0" name="Disable position control" x="0" y="0" z="0"/>
                                    </RepeatV3>
                                    <Info message="Re-discovering target bin ({target_bin})"/>
                                    <SubTree ID="DiscoverObjects" base_link="{base_link}" discovered_object="{target_bin}" target_1="{target_bin}" target_2="{__v3_empty}" target_3="{__v3_empty}" target_4="{__v3_empty}" target_error="{target_error}"/>
                                    <SubTree ID="LockInObject" object="{target_bin}" target_error="{target_error}"/>
                                    <SubTree ID="SetClawState" claw_opened="{0}" claw_raised="{1}"/>
                                    <Sequence name="Align to target bin">
                                        <SetBlackboardV3 output_key="align_pwr" value="0.1"/>
                                        <SetBlackboardV3 output_key="align_dur" value="5"/>
                                        <Info message="Dumb-aligning to target basket {target_bin}"/>
                                        <Format format="{target_bin}_frame" out="{target_bin_frame}"/>
                                        <Parallel failure_count="1" name="FF while align" success_count="1">
                                            <RetryUntilSuccessfulOrTimeout name="Never ending rotation loop" num_seconds="500">
                                                <ForceFailure>
                                                    <SubTree ID="RotateToFrame" relative_yaw="{0}" target_frame="{target_bin_frame}"/>
                                                </ForceFailure>
                                            </RetryUntilSuccessfulOrTimeout>
                                            <SubTree ID="TankLongitudinalFF" duration="{align_dur}" power="{align_pwr}"/>
                                        </Parallel>
                                        <Info message="Dump-align complete."/>
                                    </Sequence>
                                    <Info message="Dropping trash object"/>
                                    <SubTree ID="SetClawState" claw_opened="{1}" claw_raised="{1}"/>
                                    <Wait name="Wait for object to drop" seconds="3"/>
                                    <Info message="Drop complete. Backing up"/>
                                    <SubTree ID="TankLongitudinalFF" duration="{back_dur}" power="{back_pwr}"/>
                                    <Info message="Re-setting claw to idle position"/>
                                    <SubTree ID="SetClawState" claw_opened="{0}" claw_raised="{0}"/>
                                    <Info message="Disabling position control"/>
                                    <SetMappingTarget lock_map="0" target_object="" time_limit_secs="3"/>
                                    <RepeatV3 num_cycles="5">
                                        <PublishToController isOrientation="0" mode="0" x="0" y="0" z="0"/>
                                    </RepeatV3>
                                    <Info message="Table loop iteration completed."/>
                                </Sequence>
                            </Sequence>
                        </Sequence>
                        <Math a="{num_sorts}" b="1" operator="+" out="{num_sorts}"/>
                    </Sequence>
                </RepeatV3>
            </ForceSuccess>
            <Info message="Sorted {num_sorts} items."/>
        </Sequence>
    </BehaviorTree>
</root>
