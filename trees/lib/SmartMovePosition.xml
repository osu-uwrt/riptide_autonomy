<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="PrimitiveMovePosition.xml"/>
    <BehaviorTree ID="SmartMovePosition">
        <Fallback>
            <RetryUntilSuccessfulOrTimeout num_seconds="120">
                <Sequence name="Try move to position">
                    <SetBlackboardV3 output_key="timeout" value="1"/>
                    <SetBlackboardV3 output_key="sec_timeout" value="10"/>
                    <Info message="Attempting to move forward for {timeout} seconds"/>
                    <GetOdometry op="{__v3_empty}" or="{__v3_empty}" oy="{__v3_empty}" x="{old_x}" y="{old_y}" z="{old_z}"/>
                    <Fallback>
                        <SubTree ID="PrimitiveMovePosition" timeout="{timeout}" x="{x}" y="{y}" z="{z}"/>
                        <Sequence name="Evaluate possible obstacle">
                            <GetOdometry op="{__v3_empty}" or="{__v3_empty}" oy="{__v3_empty}" x="{curr_x}" y="{curr_y}" z="{curr_z}"/>
                            <Math a="{curr_z}" b="{z}" operator="-" out="{z_dist}"/>
                            <IfThenElse>
                                <CompareNums a="{z_dist}" b="0.15" test="&gt;"/>
                                <Sequence>
                                    <Info message="Bad depth! At {curr_z} but want {z}. Correcting before moving on."/>
                                    <RetryUntilSuccessfulOrTimeout num_seconds="15">
                                        <Sequence>
                                            <GetOdometry op="{__v3_empty}" or="{__v3_empty}" oy="{__v3_empty}" x="{cx}" y="{cy}" z="{cz}"/>
                                            <PublishToController isOrientation="0" mode="3" x="{cx}" y="{cy}" z="{z}"/>
                                            <Math a="{cz}" b="{z}" operator="-" out="{z_diff}"/>
                                            <CompareNums a="{z_diff}" b="0.15" test="&lt;"/>
                                        </Sequence>
                                    </RetryUntilSuccessfulOrTimeout>
                                </Sequence>
                            </IfThenElse>
                            <CalculateDistance dist="{dist_travelled}" x1="{old_x}" x2="{curr_x}" y1="{old_y}" y2="{curr_y}" z1="{old_z}" z2="{curr_z}"/>
                            <IfThenElse name="avoid obstacle if necessary">
                                <CompareNums a="{dist_travelled}" b="0" name="expect x meter travelled in timeout seconds" test="&lt;"/>
                                <RetryUntilSuccessfulOrTimeout num_seconds="60">
                                    <Sequence name="if dist &lt; something, move out the way">
                                        <SetBlackboardV3 output_key="5" value="5"/>
                                        <SetBlackboardV3 output_key="60" value="60"/>
                                        <SetBlackboardV3 output_key="-0.75" value="-0.75"/>
                                        <SetBlackboardV3 output_key="20" value="20"/>
                                        <SetBlackboardV3 output_key="15" value="15"/>
                                        <Info message="Detected an obstacle. Attempting to move out of the way"/>
                                        <SubTree ID="PrimitiveMovePosition" timeout="{60}" x="{old_x}" y="{old_y}" z="{old_z}"/>
                                        <Wait name="Wait to stablize" seconds="3"/>
                                        <TransformPose from_frame="talos/base_link" op="0" or="0" out_op="{__v3_empty}" out_or="{__v3_empty}" out_oy="{__v3_empty}" out_x="{em_x}" out_y="{em_y}" out_z="{em_z}" oy="0" to_frame="world" x="-1" y="1" z="0"/>
                                        <ForceSuccess>
                                            <SubTree ID="PrimitiveMovePosition" timeout="{5}" x="{em_x}" y="{em_y}" z="{curr_z}"/>
                                        </ForceSuccess>
                                        <ForceSuccess>
                                            <SubTree ID="PrimitiveMovePosition" timeout="{5}" x="{em_x}" y="{em_y}" z="{-0.75}"/>
                                        </ForceSuccess>
                                        <Wait name="wait for stable orientation" seconds="3"/>
                                        <TransformPose from_frame="talos/base_link" op="0" or="0" out_op="{__v3_empty}" out_or="{__v3_empty}" out_oy="{__v3_empty}" out_x="{em_x}" out_y="{em_y}" out_z="{em_z}" oy="0" to_frame="world" x="2" y="0" z="0"/>
                                        <Fallback name="move past obstacle">
                                            <SubTree ID="PrimitiveMovePosition" timeout="{15}" x="{em_x}" y="{em_y}" z="{em_z}"/>
                                            <ForceFailure>
                                                <Error message="Failed to move out of the way!"/>
                                            </ForceFailure>
                                        </Fallback>
                                    </Sequence>
                                </RetryUntilSuccessfulOrTimeout>
                                <Info message="Not there after {timeout} seconds, but made progress"/>
                            </IfThenElse>
                            <AlwaysFailure name="try move again"/>
                        </Sequence>
                    </Fallback>
                </Sequence>
            </RetryUntilSuccessfulOrTimeout>
            <ForceFailure>
                <Error message="Failed to move to XYZ position {x}, {y}, {z}. Theres something in the way"/>
            </ForceFailure>
        </Fallback>
    </BehaviorTree>
</root>
