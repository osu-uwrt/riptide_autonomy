<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID="PrimitiveMovePosition">
        <Sequence>
            <SetBlackboardV3 output_key="min_depth" value="-0.75"/>
            <SetBlackboardV3 output_key="max_depth" value="-2.5"/>
            <IfThenElse name="Ensure Z deep enough">
                <CompareNums a="{z}" b="{min_depth}" name="z above 0.75..." test="&gt;"/>
                <Sequence>
                    <Info message="Enforcing minimum depth of {min_depth} meters... requested depth was previously {z}."/>
                    <SetBlackboardV3 name="...too high" output_key="valid_z" value="{min_depth}"/>
                </Sequence>
                <SetBlackboardV3 name="...all good" output_key="valid_z" value="{z}"/>
            </IfThenElse>
            <IfThenElse name="Ensure Z shallow enough">
                <CompareNums a="{z}" b="{max_depth}" test="&lt;"/>
                <Sequence>
                    <Info message="Enforcing maximum depth of {max_depth} meters... requested depth was previously {z}."/>
                    <SetBlackboardV3 name="...too low" output_key="valid_z" value="{max_depth}"/>
                </Sequence>
                <AlwaysSuccess name="dont overwrite valid_z"/>
            </IfThenElse>
            <Info message="Translating to XYZ: {x}, {y}, {valid_z} in no more than {timeout} seconds"/>
            <RetryUntilSuccessfulOrTimeout num_seconds="{timeout}">
                <Sequence>
                    <PublishToController isOrientation="0" mode="3" x="{x}" y="{y}" z="{valid_z}"/>
                    <Wait seconds="0.25"/>
                    <GetOdometry name="Get Current XYZ" op="{__v3_empty}" or="{__v3_empty}" oy="{__v3_empty}" x="{cx}" y="{cy}" z="{cz}"/>
                    <CalculateDistance dist="{dist}" x1="{x}" x2="{cx}" y1="{y}" y2="{cy}" z1="{valid_z}" z2="{cz}"/>
                    <CompareNums a="{dist}" b="0.25" name="At goal point?" test="&lt;"/>
                </Sequence>
            </RetryUntilSuccessfulOrTimeout>
            <Info message="Translation Complete."/>
        </Sequence>
    </BehaviorTree>
</root>
