<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="Move.xml"/>
    <include path="RotateToFrame.xml"/>
    <BehaviorTree ID="SurfaceTree">
        <Sequence>
            <SetBlackboardV3 name="boolean for if surface should be epic" output_key="cool_surface" value="0"/>
            <SetBlackboardV3 name="set target pitch" output_key="target_pitch" value="-1.1"/>
            <SetBlackboardV3 output_key="target_cov" value="1"/>
            <SetBlackboardV3 name="base_link Z considered surfaced" output_key="surfaced_z" value="-0.35"/>
            <SetBlackboardV3 name="commanded Z while surfacing" output_key="surface_goal_z" value="-0.3"/>
            <TransformPose from_frame="table_frame" op="0" or="0" out_oy="{table_w}" out_x="{table_x}" out_y="{table_y}" oy="0" to_frame="world" x="0" y="0" z="0"/>
            <GetOdometry oy="{cur_yaw}"/>
            <SubTree ID="Move" op="0" or="0" oy="{cur_yaw}" x="{table_x}" y="{table_y}" z="-0.5"/>
            <IfThenElse name="rotate to image only when one is given">
                <CheckBlackboardExists input="{target_image}"/>
                <Sequence>
                    <Format format="{target_image}_frame" out="{target_image_frame}"/>
                    <ForceSuccess>
                        <SubTree ID="RotateToFrame" relative_yaw="0" target_frame="{target_image_frame}"/>
                    </ForceSuccess>
                </Sequence>
                <AlwaysSuccess name="no image, skip rotate"/>
            </IfThenElse>
            <Info message="Ascending to Z={surface_goal_z} until Z &gt; {surfaced_z}"/>
            <ForceSuccess>
                <RetryUntilSuccessfulOrTimeout name="ascend until surfaced" num_seconds="15">
                    <Sequence>
                        <PublishToController isOrientation="0" mode="3" x="{table_x}" y="{table_y}" z="{surface_goal_z}"/>
                        <Wait seconds="0.25"/>
                        <GetOdometry z="{curr_z}"/>
                        <CompareNums a="{curr_z}" b="{surfaced_z}" name="surfaced?" test="&gt;"/>
                    </Sequence>
                </RetryUntilSuccessfulOrTimeout>
            </ForceSuccess>
            <GetOdometry oy="{cur_yaw}"/>
            <SubTree ID="Move" op="0" or="0" oy="{cur_yaw}" x="{table_x}" y="{table_y}" z="-0.5"/>
        </Sequence>
    </BehaviorTree>
</root>
