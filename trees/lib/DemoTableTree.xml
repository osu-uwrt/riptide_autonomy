<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="DownwardSearch.xml"/>
    <include path="DownwardMove.xml"/>
    <include path="SetActuatorsArmed.xml"/>
    <include path="Move.xml"/>
    <include path="WaitForController.xml"/>
    <BehaviorTree ID="DemoTableTree">
        <Sequence>
            <SetBlackboardV3 output_key="minisearch_prox" value="1.5"/>
            <SetBlackboardV3 output_key="claw_topic" value="command/actuator/claw_move_s"/>
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetBlackboardV3 output_key="1" value="1"/>
            <SetBlackboardV3 output_key="claw_drop_s" value="0.3"/>
            <SetBlackboardV3 output_key="claw_open_s" value="2.0"/>
            <SetBlackboardV3 output_key="claw_close_s" value="-2.0"/>
            <SetBlackboardV3 output_key="ctrlr_timeout" value="30"/>
            <SetBlackboardV3 output_key="ctrlr_dist" value="0.01"/>
            <SetBlackboardV3 output_key="ctrlr_trust" value="0.95"/>
            <SetBlackboardV3 output_key="overtable" value="0.15"/>
            <SetBlackboardV3 output_key="claw_link" value="talos/claw_link"/>
            <SetBlackboardV3 output_key="frame" value="nut_and_bolt_frame"/>
            <SetBlackboardV3 output_key="table_target" value="nut_and_bolt"/>
            <SetBlackboardV3 output_key="dropoff_frame" value="warning_frame"/>
            <SetBlackboardV3 output_key="table_dropoff_target" value="warning"/>
            <SetBlackboardV3 output_key="search_prox" value="2"/>
            <SetBlackboardV3 output_key="target_err" value="0.2"/>
            <SetBlackboardV3 output_key="search_timeout" value="180"/>
            <ForceSuccess>
                <Sequence>
                    <SubTree ID="SetActiveCamera" is_dfc="{1}"/>
                    <SubTree ID="DownwardSearch" min_dist="{search_prox}" object_name="{table_target}" target_cov="{target_err}" timeout_sec="{search_timeout}"/>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence name="DownwardsMiniSearch">
                    <SetBlackboardV3 output_key="a_lot" value="1000"/>
                    <RetryUntilSuccessfulOrTimeout num_seconds="20">
                        <SubTree ID="DownwardMove" frame="{frame}" gx="{0}" gy="{0}" gz="{minisearch_prox}" object_name="{table_target}" reset_adjust_threshold="{a_lot}" target_Cov="{0}"/>
                    </RetryUntilSuccessfulOrTimeout>
                </Sequence>
            </ForceSuccess>
            <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
            <SetStatus status="aligning"/>
            <SubTree ID="SetActuatorsArmed" armed="{1}"/>
            <PublishFloat32 data="{claw_open_s}" topic="{claw_topic}"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="0" reference_frame="{frame}" x="0" y="0" z="{search_prox}"/>
            <SubTree ID="Move" op="{0}" or="{0}" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="0" reference_frame="{frame}" x="0" y="0" z="{overtable}"/>
            <SubTree ID="Move" op="{0}" or="{0}" oy="{boy}" x="{bx}" y="{by}" z="{bz}"/>
            <ForceSuccess>
                <SubTree ID="WaitForController" dist="{ctrlr_dist}" link_frame="{claw_link}" target_frame="{frame}" timeout="{ctrlr_timeout}" trust="{ctrlr_trust}"/>
            </ForceSuccess>
            <SetStatus status="performing"/>
            <PublishFloat32 data="{claw_close_s}" topic="{claw_topic}"/>
            <Math a="{claw_close_s}" b="1000" operator="*" out="{claw_close_ms}"/>
            <Math a="{claw_close_ms}" b="-1" operator="*" out="{claw_close_ms_neg}"/>
            <Delay delay_msec="{claw_close_ms_neg}">
                <SubTree ID="Move" op="{0}" or="{0}" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
            </Delay>
            <ForceSuccess name="DropoffSearch">
                <SubTree ID="DownwardSearch" min_dist="{search_prox}" object_name="{table_dropoff_target}" target_cov="{target_err}" timeout_sec="{search_timeout}"/>
            </ForceSuccess>
            <ForceSuccess name="Dropoff Minisearch">
                <RetryUntilSuccessfulOrTimeout num_seconds="20">
                    <SubTree ID="DownwardMove" frame="{dropoff_frame}" gx="{0}" gy="{0}" gz="{minisearch_prox}" object_name="{table_dropoff_target}" reset_adjust_threshold="{a_lot}" target_Cov="{0}"/>
                </RetryUntilSuccessfulOrTimeout>
            </ForceSuccess>
            <SetStatus status="aligning"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="0" reference_frame="{dropoff_frame}" x="0" y="0" z="{search_prox}"/>
            <SubTree ID="Move" op="{aop}" or="{aor}" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="0" reference_frame="{dropoff_frame}" x="0" y="0" z="{overtable}"/>
            <SubTree ID="Move" op="{bop}" or="{bor}" oy="{boy}" x="{bx}" y="{by}" z="{bz}"/>
            <ForceSuccess name="DropoffTrust">
                <SubTree ID="WaitForController" dist="{ctrlr_dist}" link_frame="{claw_link}" target_frame="{dropoff_frame}" timeout="{ctrlr_timeout}" trust="{ctrlr_trust}"/>
            </ForceSuccess>
            <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
            <SetStatus status="performing"/>
            <PublishFloat32 data="{claw_drop_s}" topic="{claw_topic}"/>
            <Math a="{claw_open_s}" b="1000" operator="+" out="{claw_open_ms}"/>
            <Delay delay_msec="{claw_open_ms}">
                <SubTree ID="Move" op="{0}" or="{0}" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
            </Delay>
            <PublishFloat32 data="{claw_close_s}" topic="{claw_topic}"/>
            <SubTree ID="SetActuatorsArmed" armed="{0}"/>
        </Sequence>
    </BehaviorTree>
</root>
