<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="DiscoverObjects.xml"/>
    <include path="LockInObject.xml"/>
    <include path="SmartMoveSurge.xml"/>
    <BehaviorTree ID="GoToObject">
        <Sequence name="Find bin-based discovery position">
            <RetryUntilSuccessful num_attempts="4">
                <SubTree ID="DiscoverObjects" base_link="liltank/base_link" discovered_object="{discovered_object}" target_1="{object_1}" target_2="{object_2}" target_3="{object_3}" target_4="{object_4}" target_error="{target_error}"/>
            </RetryUntilSuccessful>
            <Info message="DISCOVERED GO-ABLE OBJECT: {discovered_object}. Attempting to lock in"/>
            <SubTree ID="LockInObject" object="{discovered_object}" target_error="{target_error}"/>
            <GetOdometry z="{z}"/>
            <SubTree ID="SmartMoveSurge" timeout="60" x="0.15" z="{z}"/>
            <Repeat num_cycles="5">
                <PublishToController isOrientation="0" mode="0" name="Disable position control" x="0" y="0" z="0"/>
            </Repeat>
        </Sequence>
    </BehaviorTree>
</root>
