<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="Move.xml"/>
    <include path="MiniSearch.xml"/>
    <include path="ActivateMagnet.xml"/>
    <BehaviorTree ID="MagnetTree">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="magnet1 := 'magnet_target1'; magnet1_frame := 'magnet_target1_frame'; magnet2 := 'magnet_target2'; magnet2_frame := 'magnet_target2_frame'; object_vision_class := 'magnet'; search_prox_x := '1.25'"/>
            <Sequence>
                <ForceSuccess>
                    <CallSetStringService data="{bin_object_vision_class}" srv_name="/talos/mapping/fit_bin_geometry" time_limit_secs="3"/>
                </ForceSuccess>
                <RetryUntilSuccessful num_attempts="3">
                    <CallStartBinaryClassifierService class_name="{object_vision_class}" object1_name="{magnet1}" object2_name="{magnet2}" srv_name="/talos/mapping/start_binary_classifier" time_limit_secs="3"/>
                </RetryUntilSuccessful>
                <ForceSuccess>
                    <Sequence>
                        <SubTree ID="SetActiveCamera" is_dfc="0"/>
                        <TransformPose from_frame="{magnet1_frame}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="3.14159" to_frame="world" x="{search_prox_x}" y="0" z="0"/>
                        <SubTree ID="Move" op="0" or="0" oy="{aoy}" x="{ax}" y="{ay}" z="-0.8"/>
                        <SubTree ID="MiniSearch" object_name="{magnet1}" parent_object="{magnet1}" prox_x="{search_prox_x}" prox_y="0" prox_z="0.2" target_cov="1.25" timeout_secs="20"/>
                    </Sequence>
                </ForceSuccess>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="3">
                        <CallTriggerService srv_name="/talos/mapping/freeze_binary_classifier_buffer" time_limit_secs="3"/>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
                <SubTree ID="ActivateMagnet" magnet_frame="{magnet1_frame}"/>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="3">
                        <CallTriggerService srv_name="/talos/mapping/start_binary_classifier_second" time_limit_secs="3"/>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <ForceSuccess>
                    <Sequence>
                        <TransformPose from_frame="{magnet2_frame}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="3.14159" to_frame="world" x="{search_prox_x}" y="0" z="0"/>
                        <SubTree ID="Move" op="0" or="0" oy="{boy}" x="{bx}" y="{by}" z="-0.8"/>
                        <SubTree ID="MiniSearch" object_name="{magnet2}" parent_object="{magnet2}" prox_x="{search_prox_x}" prox_y="0" prox_z="0.2" target_cov="1.25" timeout_secs="20"/>
                    </Sequence>
                </ForceSuccess>
                <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
                <SubTree ID="ActivateMagnet" magnet_frame="{magnet2_frame}"/>
                <ForceSuccess>
                    <Sequence>
                        <TransformPose from_frame="{magnet2_frame}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="3.14159" to_frame="world" x="{search_prox_x}" y="0" z="0"/>
                        <GetOdometry oy="{cur_yaw}"/>
                        <SubTree ID="Move" op="0" or="0" oy="{cur_yaw}" x="{bx}" y="{by}" z="-0.8"/>
                    </Sequence>
                </ForceSuccess>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
