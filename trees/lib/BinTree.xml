<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="RelativeMoveNoYaw.xml"/>
    <include path="SetActiveCamera.xml"/>
    <include path="DownwardSearch.xml"/>
    <include path="SetActuatorsArmed.xml"/>
    <include path="ShootDownwardObject.xml"/>
    <include path="MagnetTree.xml"/>
    <BehaviorTree ID="BinTree">
        <Sequence>
            <ForceSuccess>
                <Sequence name="BINS">
                    <SetBlackboardV3 output_key="search_timeout" value="120"/>
                    <IfThenElse>
                        <CompareNums a="{repair_mission}" b="0" test="=="/>
                        <SetBlackboardV3 output_key="bin_object_vision_class" value="blood"/>
                        <SetBlackboardV3 output_key="bin_object_vision_class" value="fire"/>
                    </IfThenElse>
                    <SetBlackboardV3 output_key="object1" value="bin_target1"/>
                    <SetBlackboardV3 output_key="object2" value="bin_target2"/>
                    <SetBlackboardV3 output_key="search_timeout" value="120"/>
                    <Info message="BIN TIME"/>
                    <SubTree ID="RelativeMoveNoYaw" frame_name="pre_bin_pose_frame" x="0" y="0" z="0"/>
                    <SubTree ID="RelativeMoveNoYaw" frame_name="post_bin_pose_frame" x="0" y="0" z="0"/>
                    <Sequence>
                        <SubTree ID="SetActiveCamera" is_dfc="1"/>
                        <RetryUntilSuccessful num_attempts="3">
                            <CallStartBinaryClassifierService class_name="{bin_object_vision_class}" object1_name="{object1}" object2_name="{object2}" srv_name="/talos/mapping/start_binary_classifier" time_limit_secs="3"/>
                        </RetryUntilSuccessful>
                    </Sequence>
                    <ForceSuccess>
                        <SubTree ID="DownwardSearch" min_dist="2.15" object_name="{object1}" target_cov="0.02" timeout_sec="{search_timeout}"/>
                    </ForceSuccess>
                    <SubTree ID="SetActuatorsArmed" armed="1"/>
                    <ForceSuccess>
                        <SubTree ID="ShootDownwardObject" dropper_link_name="talos/droppers_link" object_name="{object1}" search_prox="2.15"/>
                    </ForceSuccess>
                    <RetryUntilSuccessful num_attempts="3">
                        <CallTriggerService srv_name="/talos/mapping/start_binary_classifier_second" time_limit_secs="3"/>
                    </RetryUntilSuccessful>
                    <ForceSuccess>
                        <Sequence>
                            <SubTree ID="DownwardSearch" min_dist="2.15" object_name="{object2}" target_cov="0.02" timeout_sec="{search_timeout}"/>
                            <SubTree ID="ShootDownwardObject" dropper_link_name="talos/droppers_link" object_name="{object2}" search_prox="2.15"/>
                        </Sequence>
                    </ForceSuccess>
                    <RetryUntilSuccessful num_attempts="3">
                        <CallTriggerService srv_name="/talos/mapping/stop_binary_classifier" time_limit_secs="3"/>
                    </RetryUntilSuccessful>
                    <SubTree ID="SetActuatorsArmed" armed="0"/>
                </Sequence>
            </ForceSuccess>
            <SubTree ID="MagnetTree" bin_object_vision_class="{bin_object_vision_class}"/>
            <SubTree ID="RelativeMoveNoYaw" frame_name="post_bin_pose_frame" x="0" y="0" z="0"/>
            <SubTree ID="RelativeMoveNoYaw" frame_name="pre_bin_pose_frame" x="0" y="0" z="0"/>
        </Sequence>
    </BehaviorTree>
</root>
