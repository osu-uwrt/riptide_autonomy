<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="RotateToFrame.xml"/>
    <include path="SurfaceTree.xml"/>
    <BehaviorTree ID="SpinTree">
        <Sequence>
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetBlackboardV3 output_key="2" value="2"/>
            <Format format="{target_image}_frame" out="{target_frame}"/>
            <ForceSuccess>
                <SubTree ID="RotateToFrame" relative_yaw="{0}" target_frame="{target_frame}"/>
            </ForceSuccess>
            <Wait seconds="2"/>
            <ContinuousSpin num_cycles="{num_cycles}" odom_timeout_secs="1" timeout_secs="120" yaw_rate="8.0"/>
            <ForceSuccess>
                <SubTree ID="RotateToFrame" relative_yaw="{0}" target_frame="{target_frame}"/>
            </ForceSuccess>
            <Wait seconds="2"/>
            <SubTree ID="SurfaceTree" target_image="{target_image}"/>
        </Sequence>
    </BehaviorTree>
</root>
