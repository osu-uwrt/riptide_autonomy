<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="Move.xml"/>
    <BehaviorTree ID="FlipTree">
        <Sequence>
            <SetBlackboardV3 output_key="0" value="0"/>
            <PublishToController isOrientation="0" mode="0" x="0" y="0" z="0"/>
            <SetControllerSafeMode safe="false" timeout_secs="10.0"/>
            <GetOdometry op="{pre_flip_op}" or="{pre_flip_or}" oy="{pre_flip_yaw}" x="{pre_flip_x}" y="{pre_flip_y}" z="{pre_flip_z}"/>
            <GetImuOrientation op="{__v3_empty}" or="{__v3_empty}" oy="{pre_imu_y}" topic="vectornav/imu"/>
            <Info message="Pre yaw: {pre_imu_y}"/>
            <TriggerControllerStunt targetStuntState="1"/>
            <Wait seconds="1"/>
            <PublishInt8 data="0" topic="controller/stunt_state"/>
            <Wait seconds="7"/>
            <GetImuOrientation op="{__v3_empty}" or="{__v3_empty}" oy="{final_imu_y}" topic="vectornav/imu"/>
            <Info message="Post imu: {final_imu_y}"/>
            <Math a="{final_imu_y}" b="{pre_imu_y}" operator="-" out="{imu_delta}"/>
            <Math a="{pre_flip_yaw}" b="{imu_delta}" operator="+" out="{post_flip_yaw}"/>
            <PublishEKFPose orientation_tolerance="0.1" pitch="{pre_flip_op}" position_tolerance="0.1" roll="{pre_flip_or}" setOrientation="true" setX="true" setY="true" setZ="false" timeout_secs="5" x="{pre_flip_x}" y="{pre_flip_y}" yaw="{post_flip_yaw}" z="{pre_flip_z}"/>
            <SubTree ID="Move" op="{pre_flip_op}" or="{pre_flip_or}" oy="{pre_flip_yaw}" x="{pre_flip_x}" y="{pre_flip_y}" z="{undergate_depth}"/>
        </Sequence>
    </BehaviorTree>
</root>
