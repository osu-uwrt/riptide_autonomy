<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="WaitForController.xml"/>
    <BehaviorTree ID="ActivateMagnetMpc">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="magnet_activation_s := '2'; magnet_align_dist := '0.0'; magnet_align_height := '0.04'; magnet_link := 'talos/magnet_link'; magnet_pre_align_dist := '0.7'; post_align_height := '-0.8'"/>
            <Sequence>
                <SetStatus status="aligning"/>
                <SetBlackboardV3 name="no retreat unless aligned" output_key="retreat_path" value=";"/>
                <ForceSuccess>
                    <Sequence name="To the magnet frame's +x side with yaw along its x in one move, then straight back into it">
                        <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{magnet_link}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="0" reference_frame="{magnet_frame}" x="{magnet_pre_align_dist}" y="0" z="{magnet_align_height}"/>
                        <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{magnet_link}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="0" reference_frame="{magnet_frame}" x="{magnet_align_dist}" y="0" z="{magnet_align_height}"/>
                        <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="retreat: back to pre-align" out="{retreat_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{ax}" y="{ay}" yaw="{aoy}" yaw_offset="" z="{az}"/>
                        <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="retreat: then up" out="{retreat_path}" path="{retreat_path}" pitch="" roll="" spin="" spin_rate="" x="{ax}" y="{ay}" yaw="{aoy}" yaw_offset="" z="{post_align_height}"/>
                        <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="pre-align: magnet link out on the frame's +x, facing +x" out="{pre_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{ax}" y="{ay}" yaw="{aoy}" yaw_offset="" z="{az}"/>
                        <FollowPath frame="" max_depth="-2.5" max_speed="" min_depth="-0.75" name="One move: there, turned and at depth" spin_rate="" timeout="60" waypoints="{pre_path}"/>
                        <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="the magnet" out="{in_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{bx}" y="{by}" yaw="{boy}" yaw_offset="" z="{bz}"/>
                        <FollowPath frame="" max_depth="-2.5" max_speed="" min_depth="-0.75" name="Straight back into it" spin_rate="" timeout="30" waypoints="{in_path}"/>
                        <SubTree ID="WaitForController" dist="0.01" link_frame="{magnet_link}" target_frame="{magnet_frame}" timeout="20" trust="0.8"/>
                    </Sequence>
                </ForceSuccess>
                <SetStatus status="performing"/>
                <Wait seconds="{magnet_activation_s}"/>
                <SetStatus status="aligning"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
