<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="AlignLink.xml"/>
    <include path="MiniSearch.xml"/>
    <include path="WaitForController.xml"/>
    <include path="FireTorpedo.xml"/>
    <BehaviorTree ID="ShootObject">
        <Sequence name="shootobject">
            <SetBlackboardV3 output_key="ctrler_timeout" value="60"/>
            <SetBlackboardV3 output_key="scale_trust" value="0.985"/>
            <SetBlackboardV3 output_key="ctrler_dist" value="0.01"/>
            <SetBlackboardV3 output_key="1" value="1"/>
            <SetBlackboardV3 output_key="shoot_prox" value="0.6"/>
            <SetBlackboardV3 output_key="ms_prox" value="1.5"/>
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetBlackboardV3 output_key="ms_timeout" value="30"/>
            <SetBlackboardV3 output_key="target_cov" value="0.0005"/>
            <Format format="{torpedo_name}_frame" out="{torpedo_frame}"/>
            <Format format="{object_name}_frame" out="{object_frame}"/>
            <Info message="Attempting to shoot object {object_name}"/>
            <ForceSuccess>
                <RetryUntilSuccessfulV3 num_attempts="2">
                    <Sequence>
                        <SubTree ID="AlignLink" frame_name="{torpedo_frame}" link_name="{torpedo_link_name}" prox_x="{ms_prox}" prox_z="{0}"/>
                        <ForceSuccess>
                            <SubTree ID="MiniSearch" object_name="{object_name}" parent_object="{torpedo_name}" prox_x="{ms_prox}" prox_y="{0}" prox_z="{0}" target_cov="{target_cov}" timeout_secs="{ms_timeout}"/>
                        </ForceSuccess>
                        <SetBlackboardV3 output_key="frame_to_shoot" value="{object_frame}"/>
                        <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
                        <SetStatus status="aligning"/>
                        <Math a="{shoot_prox}" b="0.5" operator="+" out="{shoot_prox_plus}"/>
                        <SubTree ID="AlignLink" frame_name="{frame_to_shoot}" link_name="{torpedo_link_name}" prox_x="{shoot_prox_plus}" prox_z="{0}"/>
                        <Wait name="REMOVE ME" seconds="0"/>
                        <SubTree ID="AlignLink" frame_name="{frame_to_shoot}" link_name="{torpedo_link_name}" prox_x="{shoot_prox}" prox_z="{0}"/>
                        <SubTree ID="WaitForController" dist="{ctrler_dist}" link_frame="{torpedo_link_name}" target_frame="{frame_to_shoot}" timeout="{ctrler_timeout}" trust="{scale_trust}"/>
                    </Sequence>
                </RetryUntilSuccessfulV3>
            </ForceSuccess>
            <SetStatus status="performing"/>
            <RetryUntilSuccessfulV3 num_attempts="3">
                <SubTree ID="FireTorpedo"/>
            </RetryUntilSuccessfulV3>
        </Sequence>
    </BehaviorTree>
</root>
