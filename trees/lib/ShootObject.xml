<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="AlignLink.xml"/>
    <include path="MiniSearch.xml"/>
    <include path="WaitForController.xml"/>
    <include path="FireTorpedo.xml"/>
    <BehaviorTree ID="ShootObject">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="object_frame := object_name .. '_frame'; shoot_prox := '0.6'; torpedo_frame := torpedo_name .. '_frame'"/>
            <Sequence name="shootobject">
                <Info message="Attempting to shoot object {object_name}"/>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="2">
                        <Sequence>
                            <SubTree ID="AlignLink" frame_name="{torpedo_frame}" link_name="{torpedo_link_name}" prox_x="1.5" prox_z="0"/>
                            <ForceSuccess>
                                <SubTree ID="MiniSearch" object_name="{object_name}" parent_object="{torpedo_name}" prox_x="1.5" prox_y="0" prox_z="0" target_cov="0.0005" timeout_secs="30"/>
                            </ForceSuccess>
                            <SetBlackboardV3 output_key="frame_to_shoot" value="{object_frame}"/>
                            <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
                            <SetStatus status="aligning"/>
                            <Math a="{shoot_prox}" b="0.5" operator="+" out="{shoot_prox_plus}"/>
                            <SubTree ID="AlignLink" frame_name="{frame_to_shoot}" link_name="{torpedo_link_name}" prox_x="{shoot_prox_plus}" prox_z="0"/>
                            <Wait name="REMOVE ME" seconds="0"/>
                            <SubTree ID="AlignLink" frame_name="{frame_to_shoot}" link_name="{torpedo_link_name}" prox_x="{shoot_prox}" prox_z="0"/>
                            <SubTree ID="WaitForController" dist="0.01" link_frame="{torpedo_link_name}" target_frame="{frame_to_shoot}" timeout="60" trust="0.985"/>
                        </Sequence>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <SetStatus status="performing"/>
                <RetryUntilSuccessful num_attempts="3">
                    <SubTree ID="FireTorpedo"/>
                </RetryUntilSuccessful>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
