<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="DownwardSearch.xml"/>
    <include path="DownwardMove.xml"/>
    <include path="Move.xml"/>
    <include path="WaitForController.xml"/>
    <BehaviorTree ID="pickupObject">
        <Sequence>
            <SetBlackboardV3 output_key="3.1415" value="3.1415"/>
            <Sequence name="set blackboards">
                <Format format="{object_name}_frame" out="{object_frame}"/>
                <SetBlackboardV3 output_key="0" value="0"/>
                <SetBlackboardV3 output_key="1" value="1"/>
            </Sequence>
            <SubTree ID="SetActiveCamera" is_dfc="{1}"/>
            <ForceSuccess>
                <SubTree ID="DownwardSearch" min_dist="{search_prox}" object_name="{object_name}" target_cov="{target_err}" timeout_sec="{search_timeout}"/>
            </ForceSuccess>
            <ForceSuccess>
                <RetryUntilSuccessfulOrTimeout num_seconds="10">
                    <SubTree ID="DownwardMove" frame="{object_frame}" gx="{0}" gy="{0}" gz="{minisearch_prox}" object_name="{object_name}" reset_adjust_threshold="{reset_threshold}" target_Cov="{0}"/>
                </RetryUntilSuccessfulOrTimeout>
            </ForceSuccess>
            <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
            <SetStatus status="aligning"/>
            <PublishFloat32 data="{claw_open_s}" topic="{claw_topic}"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="3.1415" reference_frame="{object_frame}" x="0" y="0" z="{search_prox}"/>
            <SubTree ID="Move" op="{0}" or="{0}" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{cop}" out_or="{cor}" out_oy="{coy}" out_x="{cx}" out_y="{cy}" out_z="{cz}" oy="3.1415" reference_frame="{object_frame}" x="0" y="0" z="{pre_overtable}"/>
            <SubTree ID="Move" op="{0}" or="{0}" oy="{coy}" x="{cx}" y="{cy}" z="{cz}"/>
            <ForceSuccess>
                <SubTree ID="WaitForController" dist="{ctrlr_dist}" link_frame="{claw_link}" target_frame="{object_frame}" timeout="{ctrlr_timeout}" trust="{ctrlr_trust}"/>
            </ForceSuccess>
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{claw_link}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="3.1415" reference_frame="{object_frame}" x="0" y="0" z="{overtable}"/>
            <SubTree ID="Move" op="{0}" or="{0}" oy="{boy}" x="{bx}" y="{by}" z="{bz}"/>
            <ForceSuccess>
                <SubTree ID="WaitForController" dist="{ctrlr_dist}" link_frame="{claw_link}" target_frame="{object_frame}" timeout="{ctrlr_timeout}" trust="{ctrlr_trust}"/>
            </ForceSuccess>
            <SetStatus status="performing"/>
            <PublishFloat32 data="{claw_close_s}" topic="{claw_topic}"/>
            <Math a="{claw_close_s}" b="-1000" operator="*" out="{claw_close_ms_neg}"/>
            <Delay delay_msec="{claw_close_ms_neg}">
                <SubTree ID="Move" op="{0}" or="{0}" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
            </Delay>
        </Sequence>
    </BehaviorTree>
</root>
