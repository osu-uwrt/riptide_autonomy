<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="DownwardSearchMpc.xml"/>
    <include path="SetActuatorsArmed.xml"/>
    <include path="ShootDownwardObjectMpc.xml"/>
    <include path="MagnetTreeMpc.xml"/>
    <BehaviorTree ID="BinTreeMpc">
        <Sequence>
            <ForceSuccess>
                <Sequence name="BINS">
                    <SetBlackboardV3 output_key="3" value="3"/>
                    <SetBlackboardV3 output_key="dropper_link" value="talos/droppers_link"/>
                    <SetBlackboardV3 output_key="search_prox" value="2.15"/>
                    <SetBlackboardV3 output_key="search_timeout" value="120"/>
                    <IfThenElse>
                        <CompareNums a="{repair_mission}" b="0" test="=="/>
                        <SetBlackboardV3 output_key="bin_object_vision_class" value="blood"/>
                        <SetBlackboardV3 output_key="bin_object_vision_class" value="fire"/>
                    </IfThenElse>
                    <SetBlackboardV3 output_key="0" value="0"/>
                    <SetBlackboardV3 output_key="1" value="1"/>
                    <SetBlackboardV3 output_key="object1" value="bin_target1"/>
                    <SetBlackboardV3 output_key="object2" value="bin_target2"/>
                    <SetBlackboardV3 output_key="target_err" value="0.02"/>
                    <SetBlackboardV3 output_key="search_timeout" value="120"/>
                    <Info message="BIN TIME"/>
                    <SetBlackboardV3 output_key="pre_bin_pose_frame" value="pre_bin_pose_frame"/>
                    <SetBlackboardV3 output_key="post_bin_pose_frame" value="post_bin_pose_frame"/>
                    <Sequence>
                        <SubTree ID="SetActiveCamera" is_dfc="{1}"/>
                        <RetryUntilSuccessfulV3 num_attempts="3">
                            <CallStartBinaryClassifierService class_name="{bin_object_vision_class}" object1_name="{object1}" object2_name="{object2}" srv_name="/talos/mapping/start_binary_classifier" time_limit_secs="3"/>
                        </RetryUntilSuccessfulV3>
                    </Sequence>
                    <ForceSuccess>
                        <SubTree ID="DownwardSearchMpc" min_dist="{search_prox}" object_name="{object1}" target_cov="{target_err}" timeout_sec="{search_timeout}"/>
                    </ForceSuccess>
                    <SubTree ID="SetActuatorsArmed" armed="{1}"/>
                    <ForceSuccess>
                        <SubTree ID="ShootDownwardObjectMpc" dropper_link_name="{dropper_link}" object_name="{object1}" search_prox="{search_prox}"/>
                    </ForceSuccess>
                    <RetryUntilSuccessfulV3 num_attempts="3">
                        <CallTriggerService srv_name="/talos/mapping/start_binary_classifier_second" time_limit_secs="3"/>
                    </RetryUntilSuccessfulV3>
                    <ForceSuccess>
                        <Sequence>
                            <SubTree ID="DownwardSearchMpc" min_dist="{search_prox}" object_name="{object2}" target_cov="{target_err}" timeout_sec="{search_timeout}"/>
                            <SubTree ID="ShootDownwardObjectMpc" dropper_link_name="{dropper_link}" object_name="{object2}" search_prox="{search_prox}"/>
                        </Sequence>
                    </ForceSuccess>
                    <RetryUntilSuccessfulV3 num_attempts="3">
                        <CallTriggerService srv_name="/talos/mapping/stop_binary_classifier" time_limit_secs="3"/>
                    </RetryUntilSuccessfulV3>
                    <SubTree ID="SetActuatorsArmed" armed="{0}"/>
                </Sequence>
            </ForceSuccess>
            <SubTree ID="MagnetTreeMpc" bin_object_vision_class="{bin_object_vision_class}"/>
        </Sequence>
    </BehaviorTree>
</root>
