<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="Move.xml"/>
    <BehaviorTree ID="AlignLink">
        <Sequence name="align robot link">
            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{link_name}" op="0" or="0" out_op="{gop}" out_or="{gor}" out_oy="{goy}" out_x="{gx}" out_y="{gy}" out_z="{gz}" oy="3.1415" reference_frame="{frame_name}" x="{prox_x}" y="0" z="{prox_z}"/>
            <SubTree ID="Move" op="{gop}" or="{gor}" oy="{goy}" x="{gx}" y="{gy}" z="{gz}"/>
        </Sequence>
    </BehaviorTree>
</root>
