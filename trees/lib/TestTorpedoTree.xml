<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="Search.xml"/>
    <include path="MiniSearch.xml"/>
    <include path="SetActuatorsArmed.xml"/>
    <include path="ShootSearchedObject.xml"/>
    <BehaviorTree ID="TestTorpedoTree">
        <Sequence name="TEST TORPEDO">
            <IfThenElse>
                <CompareNums a="{repair_mission}" b="0" test="=="/>
                <Sequence>
                    <SetBlackboardV3 output_key="torpedo_first" value="blood_hole_large"/>
                    <SetBlackboardV3 output_key="torpedo_second" value="blood_hole_small"/>
                </Sequence>
                <Sequence>
                    <SetBlackboardV3 output_key="torpedo_first" value="fire_hole_large"/>
                    <SetBlackboardV3 output_key="torpedo_second" value="fire_hole_small"/>
                </Sequence>
            </IfThenElse>
            <ForceSuccess>
                <Sequence>
                    <SubTree ID="SetActiveCamera" is_dfc="0"/>
                    <SubTree ID="Search" max_dist="2" min_dist="1" object_name="torpedo" target_cov="0.0025" timeout_secs="60"/>
                </Sequence>
            </ForceSuccess>
            <Sequence name="Refine both holes before shooting">
                <ForceSuccess>
                    <SubTree ID="MiniSearch" object_name="{torpedo_first}" parent_object="torpedo" prox_x="1.5" prox_y="0" prox_z="0" target_cov="0.0005" timeout_secs="30"/>
                </ForceSuccess>
                <ForceSuccess>
                    <SubTree ID="MiniSearch" object_name="{torpedo_second}" parent_object="torpedo" prox_x="1.5" prox_y="0" prox_z="0" target_cov="0.0005" timeout_secs="30"/>
                </ForceSuccess>
                <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
            </Sequence>
            <Fallback name="Try run while armed">
                <Sequence name="torpedo">
                    <SubTree ID="SetActuatorsArmed" armed="1"/>
                    <SubTree ID="ShootSearchedObject" object_name="{torpedo_first}" torpedo_link_name="talos/torpedo_0_link"/>
                    <SubTree ID="ShootSearchedObject" object_name="{torpedo_second}" torpedo_link_name="talos/torpedo_1_link"/>
                </Sequence>
                <ForceFailure>
                    <Sequence name="handle fail">
                        <Error message="Torpedo tree failed, disarming actuators"/>
                        <SubTree ID="SetActuatorsArmed" armed="0"/>
                    </Sequence>
                </ForceFailure>
            </Fallback>
            <Sequence name="handle success">
                <Info message="Torpedo tree succeeded, disarming torpedos"/>
                <SubTree ID="SetActuatorsArmed" armed="0"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
