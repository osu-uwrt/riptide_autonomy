<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID="WaitForKillSwitch">
        <Sequence>
            <SetStatus status="waiting"/>
            <Info message="Waiting for kill switch insert..."/>
            <Wait seconds="5"/>
            <RetryUntilSuccessfulV3 num_attempts="-1">
                <Sequence>
                    <GetBoolTopic topic="state/kill" value="{kill_switch_inserted}"/>
                    <Inverter name="IsFalse">
                        <IsTrue value="{kill_switch_inserted}"/>
                    </Inverter>
                    <Wait seconds="1"/>
                    <Info message="KILL SWITCH INSERTED, TREE STARTING IN 5 SECONDS"/>
                </Sequence>
            </RetryUntilSuccessfulV3>
            <SetStatus status="starting"/>
            <Wait seconds="5"/>
        </Sequence>
    </BehaviorTree>
</root>
