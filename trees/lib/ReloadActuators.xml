<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID="ReloadActuators">
        <Fallback>
            <Sequence>
                <Info message="Attempting to notify actuators to reload..."/>
                <RetryUntilSuccessfulV3 num_attempts="3">
                    <CallTriggerService srv_name="command/actuator/notify_reload" time_limit_secs="2"/>
                </RetryUntilSuccessfulV3>
                <Info message="Actuator reload successful."/>
            </Sequence>
            <ForceFailure>
                <Error message="Failed to notify actuator reload after 3 attempts"/>
            </ForceFailure>
        </Fallback>
    </BehaviorTree>
</root>
