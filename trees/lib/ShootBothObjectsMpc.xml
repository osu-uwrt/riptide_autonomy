<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="WaitForController.xml"/>
    <include path="FireTorpedo.xml"/>
    <include path="SearchMpc.xml"/>
    <BehaviorTree ID="ShootBothObjectsMpc">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="backoff_m := '1'; both_holes := object_1 .. ',' .. object_2 .. ','; camera_link := 'talos/ffc_base_link'; ms_prox := '1.5'; ms_timeout := '40'; neg_backoff_m := '-1'; neg_square_tol := '-0.035'; object_1_frame := object_1 .. '_frame'; object_2_frame := object_2 .. '_frame'; see_timeout := '8'; shoot_prox := '0.6'; shoot_prox_plus := '1.1'; square_tol := '0.035'; target_cov := '0.0005'; torpedo_frame := torpedo_name .. '_frame'"/>
            <Sequence name="Search both holes, then shoot both">
                <Info message="Searching {object_1} and {object_2} before shooting"/>
                <ForceSuccess>
                    <RetryUntilSuccessful name="Stand off and map the holes; if they can't be seen there, back off and search the board again" num_attempts="3">
                        <Sequence>
                            <ForceSuccess>
                                <Sequence name="Stand off in front of the board">
                                    <TransformPose from_frame="{camera_link}" name="the camera's tilt now (kept, so the vehicle stays level)" op="0" or="0" out_op="{cam_pitch}" out_or="{cam_roll}" oy="0" to_frame="{torpedo_frame}" x="0" y="0" z="0"/>
                                    <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{camera_link}" name="camera (not a launcher) centered and square on the board, so the holes are mid-image" op="{cam_pitch}" or="{cam_roll}" out_oy="{board_yaw}" out_x="{board_x}" out_y="{board_y}" out_z="{board_z}" oy="3.1415" reference_frame="{torpedo_frame}" x="{ms_prox}" y="0" z="0"/>
                                    <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="board standoff" out="{board_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{board_x}" y="{board_y}" yaw="{board_yaw}" yaw_frame="" yaw_offset="" z="{board_z}"/>
                                    <FollowPath frame="" max_depth="-10" max_speed="" min_depth="-0.75" spin_rate="" timeout="60" waypoints="{board_path}"/>
                                </Sequence>
                            </ForceSuccess>
                            <SetStatus status="searching"/>
                            <SetMappingTarget lock_map="0" name="Map both holes at once" target_object="{both_holes}" time_limit_secs="3"/>
                            <Fallback name="See the holes from the standoff, or back off and search the board again">
                                <RetryUntilSuccessfulOrTimeout name="Wait for a hole detection" num_seconds="{see_timeout}">
                                    <Sequence>
                                        <Wait seconds="0.25"/>
                                        <Fallback>
                                            <SeenRecently max_age_secs="1.0" min_score="0.2" object_name="{object_1}"/>
                                            <SeenRecently max_age_secs="1.0" min_score="0.2" object_name="{object_2}"/>
                                        </Fallback>
                                    </Sequence>
                                </RetryUntilSuccessfulOrTimeout>
                                <ForceFailure name="Can't see the holes: back straight off, search the board again, then retry the standoff">
                                    <Sequence>
                                        <Info message="No hole detections from the standoff in {see_timeout} s: backing off {backoff_m} m and searching {torpedo_name} again"/>
                                        <TransformPose from_frame="talos/base_link" name="straight back from here, same heading" op="0" or="0" out_oy="{back_yaw}" out_x="{back_x}" out_y="{back_y}" out_z="{back_z}" oy="0" to_frame="world" x="{neg_backoff_m}" y="0" z="0"/>
                                        <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="backed off" out="{back_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{back_x}" y="{back_y}" yaw="{back_yaw}" yaw_frame="" yaw_offset="" z="{back_z}"/>
                                        <FollowPath frame="" max_depth="-10" max_speed="" min_depth="-0.75" spin_rate="" timeout="20" waypoints="{back_path}"/>
                                        <SubTree ID="SearchMpc" max_dist="2" min_dist="1" name="Board re-search: as the torpedo tree's first search; a full SearchMpc cycle is about 160 s" object_name="{torpedo_name}" target_cov="0.0025" timeout_secs="180"/>
                                    </Sequence>
                                </ForceFailure>
                            </Fallback>
                            <ForceSuccess>
                                <RetryUntilSuccessfulOrTimeout name="Hold until both holes converge with the camera square on to them, re-squaring onto the holes' own normal" num_seconds="{ms_timeout}">
                                    <Sequence>
                                        <Wait seconds="0.25"/>
                                        <MapConverged object="{object_1}" target_cov="{target_cov}"/>
                                        <MapConverged object="{object_2}" target_cov="{target_cov}"/>
                                        <TransformPose from_frame="{object_2_frame}" name="hole 2 in hole 1's frame" op="0" or="0" out_y="{h2_y}" out_z="{h2_z}" oy="0" to_frame="{object_1_frame}" x="0" y="0" z="0"/>
                                        <Math a="{h2_y}" b="0.5" operator="*" out="{mid_y}"/>
                                        <Math a="{h2_z}" b="0.5" operator="*" out="{mid_z}"/>
                                        <TransformPose from_frame="{object_1_frame}" name="1 m along the holes' normal, in the camera frame" op="0" or="0" out_y="{n1_y}" oy="0" to_frame="{camera_link}" x="1" y="0" z="0"/>
                                        <TransformPose from_frame="{object_1_frame}" name="hole 1 in the camera frame" op="0" or="0" out_y="{n0_y}" oy="0" to_frame="{camera_link}" x="0" y="0" z="0"/>
                                        <Math a="{n1_y}" b="{n0_y}" name="sin of the camera's yaw off the holes' normal" operator="-" out="{square_err}"/>
                                        <Info message="Holes converged; camera is {square_err} (sin yaw) off their normal"/>
                                        <Fallback>
                                            <Sequence name="square on (within ~2 deg): lock it in">
                                                <CompareNums a="{square_err}" b="{square_tol}" test="&lt;"/>
                                                <CompareNums a="{square_err}" b="{neg_square_tol}" test="&gt;"/>
                                            </Sequence>
                                            <ForceFailure name="not square: move the camera square on to the holes' midpoint, then look again">
                                                <Sequence>
                                                    <TransformPose from_frame="{camera_link}" name="the camera's tilt now (kept, so the vehicle stays level)" op="0" or="0" out_op="{cam_pitch}" out_or="{cam_roll}" oy="0" to_frame="{object_1_frame}" x="0" y="0" z="0"/>
                                                    <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{camera_link}" name="camera square on to the holes' midpoint" op="{cam_pitch}" or="{cam_roll}" out_oy="{sq_yaw}" out_x="{sq_x}" out_y="{sq_y}" out_z="{sq_z}" oy="3.1415" reference_frame="{object_1_frame}" x="{ms_prox}" y="{mid_y}" z="{mid_z}"/>
                                                    <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="square on to the holes" out="{square_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{sq_x}" y="{sq_y}" yaw="{sq_yaw}" yaw_frame="" yaw_offset="" z="{sq_z}"/>
                                                    <FollowPath frame="" max_depth="-10" max_speed="" min_depth="-0.75" spin_rate="" timeout="15" waypoints="{square_path}"/>
                                                </Sequence>
                                            </ForceFailure>
                                        </Fallback>
                                    </Sequence>
                                </RetryUntilSuccessfulOrTimeout>
                            </ForceSuccess>
                        </Sequence>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <SetMappingTarget lock_map="0" name="Square on now: map the holes again so only these detections count (an earlier look from an angle is not carried into the lock)" target_object="{both_holes}" time_limit_secs="3"/>
                <ForceSuccess>
                    <RetryUntilSuccessfulOrTimeout name="Hold square on until both holes converge on the fresh detections" num_seconds="{ms_timeout}">
                        <Sequence>
                            <Wait seconds="0.25"/>
                            <MapConverged object="{object_1}" target_cov="{target_cov}"/>
                            <MapConverged object="{object_2}" target_cov="{target_cov}"/>
                        </Sequence>
                    </RetryUntilSuccessfulOrTimeout>
                </ForceSuccess>
                <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
                <SetStatus status="aligning"/>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="2">
                        <Sequence name="Align torpedo 1 on hole 1 (1.1 m then 0.6 m as one path)">
                            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{link_1}" op="0" or="0" out_oy="{a1_yaw}" out_x="{a1_x}" out_y="{a1_y}" out_z="{a1_z}" oy="3.1415" reference_frame="{object_1_frame}" x="{shoot_prox_plus}" y="0" z="0"/>
                            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{link_1}" op="0" or="0" out_oy="{s1_yaw}" out_x="{s1_x}" out_y="{s1_y}" out_z="{s1_z}" oy="3.1415" reference_frame="{object_1_frame}" x="{shoot_prox}" y="0" z="0"/>
                            <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="hole 1 at 1.1 m" out="{shot_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{a1_x}" y="{a1_y}" yaw="{a1_yaw}" yaw_frame="" yaw_offset="" z="{a1_z}"/>
                            <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="hole 1 at firing distance" out="{shot_path}" path="{shot_path}" pitch="" roll="" spin="" spin_rate="" x="{s1_x}" y="{s1_y}" yaw="{s1_yaw}" yaw_frame="" yaw_offset="" z="{s1_z}"/>
                            <FollowPath frame="" max_depth="-10" max_speed="" min_depth="-0.75" spin_rate="" timeout="60" waypoints="{shot_path}"/>
                            <SubTree ID="WaitForController" dist="0.01" link_frame="{link_1}" target_frame="{object_1_frame}" timeout="60" trust="0.985"/>
                        </Sequence>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <SetStatus status="performing"/>
                <Info message="Firing at {object_1}"/>
                <RetryUntilSuccessful num_attempts="3">
                    <SubTree ID="FireTorpedo"/>
                </RetryUntilSuccessful>
                <SetStatus status="aligning"/>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="2">
                        <Sequence name="Slide across to hole 2 at firing distance">
                            <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{link_2}" op="0" or="0" out_oy="{s2_yaw}" out_x="{s2_x}" out_y="{s2_y}" out_z="{s2_z}" oy="3.1415" reference_frame="{object_2_frame}" x="{shoot_prox}" y="0" z="0"/>
                            <AddWaypoint frame="" heading="" look_frame="" look_x="" look_y="" look_z="" name="hole 2 at firing distance" out="{shot_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{s2_x}" y="{s2_y}" yaw="{s2_yaw}" yaw_frame="" yaw_offset="" z="{s2_z}"/>
                            <FollowPath frame="" max_depth="-10" max_speed="" min_depth="-0.75" spin_rate="" timeout="60" waypoints="{shot_path}"/>
                            <SubTree ID="WaitForController" dist="0.01" link_frame="{link_2}" target_frame="{object_2_frame}" timeout="60" trust="0.985"/>
                        </Sequence>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <SetStatus status="performing"/>
                <Info message="Firing at {object_2}"/>
                <RetryUntilSuccessful num_attempts="3">
                    <SubTree ID="FireTorpedo"/>
                </RetryUntilSuccessful>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
