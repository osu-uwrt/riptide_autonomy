<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="RelativeMove.xml"/>
    <include path="PrimitiveMoveOrientation.xml"/>
    <include path="SmartMovePosition.xml"/>
    <include path="Move.xml"/>
    <include path="CollectDetsAtAngle.xml"/>
    <BehaviorTree ID="Search">
        <Sequence name="Search">
            <Info message="Searching for {object_name} with target covariance {target_cov}"/>
            <SetBlackboardV3 output_key="3.1415" value="3.1415"/>
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetStatus status="searching"/>
            <Format format="{object_name}_frame" out="{frame}"/>
            <SetBlackboardV3 output_key="dist" value="{max_dist}"/>
            <SubTree ID="RelativeMove" frame_name="{frame}" op="{0}" or="{0}" oy="{3.1415}" x="{dist}" y="{0}" z="{0}"/>
            <SetMappingTarget lock_map="0" target_object="{object_name}" time_limit_secs="3"/>
            <GetOdometry op="{op}" or="{or}" oy="{oy}" x="{x}" y="{y}" z="{z}"/>
            <TransformPose from_frame="{frame}" op="0" or="0" out_op="{f_op}" out_or="{f_or}" out_oy="{f_oy}" out_x="{f_x}" out_y="{f_y}" out_z="{f_z}" oy="0" to_frame="world" x="0" y="0" z="0"/>
            <Fallback>
                <CompareNums a="{dist}" b="{max_dist}" test="&gt;"/>
                <SetBlackboardV3 output_key="dist" value="{max_dist}"/>
            </Fallback>
            <RetryUntilSuccessfulOrTimeout name="Search Loop" num_seconds="{timeout_secs}">
                <Sequence name="Search Loop">
                    <SetBlackboardV3 output_key="15" value="15"/>
                    <Info message="Search moving to {dist} meters away from {object_name}"/>
                    <TransformPose from_frame="{frame}" op="0" or="0" out_op="{gop}" out_or="{gor}" out_oy="{goy}" out_x="{gx}" out_y="{gy}" out_z="{gz}" oy="3.1415" to_frame="world" x="{dist}" y="0" z="0"/>
                    <SubTree ID="PrimitiveMoveOrientation" p="{gop}" r="{gor}" timeout="{15}" y="{goy}"/>
                    <SubTree ID="SmartMovePosition" x="{gx}" y="{gy}" z="{gz}"/>
                    <SubTree ID="Move" op="{0}" or="{0}" oy="{goy}" x="{gx}" y="{gy}" z="{gz}"/>
                    <Info message="Let mapping gather detections on {object_name}"/>
                    <SetBlackboardV3 name="pi/6" output_key="angle" value="0.7854"/>
                    <ForceSuccess name="Search at position">
                        <Fallback>
                            <SubTree ID="CollectDetsAtAngle" frame="{frame}" rel_yaw="{0}" target="{object_name}" target_error="{target_cov}"/>
                            <SubTree ID="CollectDetsAtAngle" frame="{frame}" rel_yaw="{angle}" target="{object_name}" target_error="{target_cov}"/>
                            <Sequence>
                                <Math a="{angle}" b="-1" operator="*" out="{neg_angle}"/>
                                <SubTree ID="CollectDetsAtAngle" frame="{frame}" rel_yaw="{neg_angle}" target="{object_name}" target_error="{target_cov}"/>
                            </Sequence>
                        </Fallback>
                    </ForceSuccess>
                    <getCovariance Covariance="{cov}" Target="{object_name}"/>
                    <Info message="object {object_name} covariance at {cov}, target is {target_cov}, distance is {dist}"/>
                    <Fallback name="Check covariance and distance">
                        <CompareNums a="{cov}" b="{target_cov}" name="did we find it yet" test="&lt;"/>
                        <ForceFailure>
                            <IfThenElse name="figure out new dist">
                                <CompareNums a="{dist}" b="{min_dist}" name="are we far enough away?" test="&gt;"/>
                                <Sequence>
                                    <Math a="{dist}" b="0.67" name="Make dist smaller" operator="*" out="{dist}"/>
                                    <IfThenElse name="Enforce minimum dist">
                                        <CompareNums a="{dist}" b="{min_dist}" test="&lt;"/>
                                        <SetBlackboardV3 output_key="dist" value="{min_dist}"/>
                                        <AlwaysSuccess/>
                                    </IfThenElse>
                                </Sequence>
                                <Sequence name="back up">
                                    <Info message="Got too close ({dist} meters) without finding object. Backing up"/>
                                    <SetBlackboardV3 output_key="dist" value="{max_dist}"/>
                                </Sequence>
                            </IfThenElse>
                        </ForceFailure>
                    </Fallback>
                </Sequence>
            </RetryUntilSuccessfulOrTimeout>
            <Fallback name="check distance">
                <CompareNums a="{cov}" b="{target_cov}" test="&lt;"/>
                <CompareNums a="{dist}" b="{min_dist}" test="&gt;"/>
                <ForceFailure>
                    <Error message="Could not find {object_name} after {timeout_secs} seconds."/>
                </ForceFailure>
            </Fallback>
        </Sequence>
    </BehaviorTree>
</root>
