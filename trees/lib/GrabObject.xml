<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="DiscoverObjects.xml"/>
    <include path="SetClawState.xml"/>
    <include path="LockInObject.xml"/>
    <include path="SmartMoveSurge.xml"/>
    <include path="TankLongitudinalFF.xml"/>
    <BehaviorTree ID="GrabObject">
        <Sequence name="Discover trash">
            <SubTree ID="DiscoverObjects" base_link="liltank/base_link" discovered_object="{discovered_target}" target_1="{object_1}" target_2="{object_2}" target_3="{object_3}" target_4="{object_4}" target_error="{target_error}"/>
            <Info message="DISCOVERED GRABBABLE OBJECT {discovered_target}. Attempting to lock in"/>
            <SubTree ID="SetClawState" claw_opened="1" claw_raised="0"/>
            <SubTree ID="LockInObject" object="{discovered_target}" target_error="{target_error}"/>
            <GetOdometry z="{z}"/>
            <SubTree ID="SmartMoveSurge" timeout="60" x="0.15" z="{z}"/>
            <Repeat num_cycles="5">
                <PublishToController isOrientation="0" mode="0" name="Disable position control" x="0" y="0" z="0"/>
            </Repeat>
            <SubTree ID="SetClawState" claw_opened="0" claw_raised="0"/>
            <SubTree ID="TankLongitudinalFF" duration="1" power="-0.2"/>
        </Sequence>
    </BehaviorTree>
</root>
