<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="SetActiveCamera.xml"/>
    <include path="Search.xml"/>
    <include path="RelativeMove.xml"/>
    <BehaviorTree ID="BuoyTree">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="circ_radius := '1.25'; iscw := '1'; prop := 'buoy'; prop_frame := prop .. '_frame'"/>
            <Sequence name="buoy">
                <ForceSuccess>
                    <Sequence>
                        <SubTree ID="SetActiveCamera" is_dfc="0"/>
                        <SubTree ID="Search" max_dist="2.5" min_dist="1" object_name="{prop}" target_cov="0.1" timeout_secs="45"/>
                    </Sequence>
                </ForceSuccess>
                <Info message="BUOY TIME"/>
                <SetStatus name="set status to aligning" status="aligning"/>
                <IfThenElse name="which way we goin">
                    <CompareNums a="{iscw}" b="0" name="what is the value" test="=="/>
                    <SetBlackboardV3 output_key="circ_y" value="1"/>
                    <SetBlackboardV3 output_key="circ_y" value="-1"/>
                </IfThenElse>
                <Math a="{circ_y}" b="{circ_radius}" name="multiply by radius to get actual y" operator="*" out="{circ_y}"/>
                <Info message="Lining up with buoy"/>
                <SubTree ID="RelativeMove" frame_name="{prop_frame}" op="0" or="0" oy="3.1415" x="{circ_radius}" y="0" z="0"/>
                <SetStatus name="performing" status="performing"/>
                <SubTree ID="RelativeMove" frame_name="{prop_frame}" op="0" or="0" oy="3.1415" x="0" y="{circ_y}" z="0"/>
                <Math a="{circ_radius}" b="-1" name="get behind buoy x" operator="*" out="{n_circ_radius}"/>
                <SubTree ID="RelativeMove" frame_name="{prop_frame}" op="0" or="0" oy="3.1415" x="{n_circ_radius}" y="0" z="0"/>
                <Math a="{circ_y}" b="-1" name="get other side of buoy y" operator="*" out="{n_circ_y}"/>
                <SubTree ID="RelativeMove" frame_name="{prop_frame}" op="0" or="0" oy="3.1415" x="0" y="{n_circ_y}" z="0"/>
                <SubTree ID="RelativeMove" frame_name="{prop_frame}" op="0" or="0" oy="3.1415" x="{circ_radius}" y="0" z="0"/>
                <SetStatus name="moving to better spot" status="moving"/>
                <SubTree ID="RelativeMove" frame_name="{prop_frame}" op="0" or="0" oy="3.1415" x="0" y="{circ_y}" z="0"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
