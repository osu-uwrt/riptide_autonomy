<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="Move.xml"/>
    <BehaviorTree ID="RelativeMoveNoYaw">
        <Sequence>
            <TransformPose from_frame="{frame_name}" op="0" or="0" out_x="{gx}" out_y="{gy}" out_z="{gz}" oy="0" to_frame="world" x="{x}" y="{y}" z="{z}"/>
            <GetOdometry oy="{cur_yaw}"/>
            <SubTree ID="Move" op="0" or="0" oy="{cur_yaw}" x="{gx}" y="{gy}" z="{gz}"/>
        </Sequence>
    </BehaviorTree>
</root>
