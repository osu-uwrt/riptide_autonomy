<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="Move.xml"/>
    <include path="WaitForController.xml"/>
    <BehaviorTree ID="ActivateMagnet">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="magnet_activation_s := '2'; magnet_align_dist := '0.0'; magnet_align_height := '0.04'; magnet_link := 'talos/magnet_link'; magnet_pre_align_dist := '0.7'"/>
            <Sequence>
                <SetStatus status="aligning"/>
                <ForceSuccess>
                    <Sequence>
                        <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{magnet_link}" op="0" or="0" out_op="{aop}" out_or="{aor}" out_oy="{aoy}" out_x="{ax}" out_y="{ay}" out_z="{az}" oy="0" reference_frame="{magnet_frame}" x="{magnet_pre_align_dist}" y="0" z="{magnet_align_height}"/>
                        <SubTree ID="Move" op="0" or="0" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
                    </Sequence>
                </ForceSuccess>
                <ForceSuccess>
                    <Sequence>
                        <ComputeFrameAlignment base_frame="talos/base_link" link_frame="{magnet_link}" op="0" or="0" out_op="{bop}" out_or="{bor}" out_oy="{boy}" out_x="{bx}" out_y="{by}" out_z="{bz}" oy="0" reference_frame="{magnet_frame}" x="{magnet_align_dist}" y="0" z="{magnet_align_height}"/>
                        <SubTree ID="Move" op="0" or="0" oy="{boy}" x="{bx}" y="{by}" z="{bz}"/>
                        <SubTree ID="WaitForController" dist="0.01" link_frame="{magnet_link}" target_frame="{magnet_frame}" timeout="20" trust="0.8"/>
                    </Sequence>
                </ForceSuccess>
                <SetStatus status="performing"/>
                <Wait seconds="{magnet_activation_s}"/>
                <SetStatus status="aligning"/>
                <SubTree ID="Move" op="0" or="0" oy="{aoy}" x="{ax}" y="{ay}" z="{az}"/>
                <SubTree ID="Move" op="0" or="0" oy="{aoy}" x="{ax}" y="{ay}" z="-0.8"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
