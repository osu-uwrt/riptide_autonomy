<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <include path="MiniSearch.xml"/>
    <BehaviorTree ID="SlalomPath">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="space_between_slaloms := '1.5'; whole_slalom_width := '3.2'"/>
            <Sequence name="Slalom">
                <Info message="SALMONI TIME"/>
                <ForceSuccess>
                    <RetryUntilSuccessful num_attempts="3">
                        <CallSetStringService data="slalom_parent" srv_name="set_slalom_type" time_limit_secs="3"/>
                    </RetryUntilSuccessful>
                </ForceSuccess>
                <ForceSuccess>
                    <SubTree ID="MiniSearch" object_name="slalom_parent" parent_object="slalom_parent" prox_x="2.5" prox_y="0" prox_z="0" target_cov="0.3" timeout_secs="15"/>
                </ForceSuccess>
                <SetMappingTarget lock_map="1" target_object="" time_limit_secs="3"/>
                <Math a="{whole_slalom_width}" b="4" operator="/" out="{slalom_lat_offset_pos}"/>
                <Math a="{space_between_slaloms}" b="2" operator="/" out="{slalom_long_offset_pos}"/>
                <Math a="{slalom_lat_offset_pos}" b="-1" operator="*" out="{slalom_lat_offset_neg}"/>
                <Math a="{slalom_long_offset_pos}" b="-0.5" operator="*" out="{slalom_long_offset_neg}"/>
                <IfThenElse name="Choose lateral slalom offset">
                    <CompareNums a="{pass_on_left}" b="1" test="=="/>
                    <SetBlackboardV3 name="Negative is left bc we are facing the object" output_key="slalom_lat_offset" value="{slalom_lat_offset_neg}"/>
                    <SetBlackboardV3 name="Positive is right bc we are facing the object" output_key="slalom_lat_offset" value="{slalom_lat_offset_pos}"/>
                </IfThenElse>
                <Info message="Slalom as one path through the front, middle and back gates"/>
                <AddWaypoint frame="slalom_front_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="front gate: before" out="{slalom_path}" path="" pitch="" roll="" spin="" spin_rate="" x="{slalom_long_offset_pos}" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_front_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="front gate: through" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="0" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_front_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="front gate: after" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="{slalom_long_offset_neg}" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_middle_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="middle gate: before" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="{slalom_long_offset_pos}" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_middle_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="middle gate: through" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="0" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_middle_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="middle gate: after" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="{slalom_long_offset_neg}" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_back_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="back gate: before" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="{slalom_long_offset_pos}" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_back_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="back gate: through" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="0" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <AddWaypoint frame="slalom_back_frame" heading="" look_frame="" look_x="" look_y="" look_z="" name="back gate: after" out="{slalom_path}" path="{slalom_path}" pitch="" roll="" spin="" spin_rate="" x="{slalom_long_offset_neg}" y="{slalom_lat_offset}" yaw="3.1415" yaw_offset="" z="0"/>
                <FollowPath frame="" max_depth="" min_depth="" spin_rate="" timeout="120" waypoints="{slalom_path}"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
