<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/WaitForKillSwitch.xml"/>
    <include path="lib/Dive.xml"/>
    <include path="lib/SlalomTree.xml"/>
    <include path="lib/TorpedoTree.xml"/>
    <include path="lib/BinTree.xml"/>
    <include path="lib/SurfaceTree.xml"/>
    <include path="lib/KillController.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <Sequence name="COMP">
            <SubTree ID="WaitForKillSwitch"/>
            <SubTree ID="Dive" depth="-0.56"/>
            <ForceSuccess>
                <SubTree ID="SlalomTree" pass_on_left="{pass_on_left}"/>
            </ForceSuccess>
            <ForceSuccess>
                <SubTree ID="TorpedoTree"/>
            </ForceSuccess>
            <ForceSuccess>
                <SubTree ID="BinTree"/>
            </ForceSuccess>
            <ForceSuccess>
                <SubTree ID="SurfaceTree"/>
            </ForceSuccess>
            <SubTree ID="KillController"/>
        </Sequence>
    </BehaviorTree>
</root>
