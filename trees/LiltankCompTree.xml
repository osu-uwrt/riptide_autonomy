<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/WaitForKillSwitch.xml"/>
    <include path="lib/Dive.xml"/>
    <include path="lib/WaitForTalos.xml"/>
    <include path="lib/SetClawState.xml"/>
    <include path="lib/TableTree.xml"/>
    <include path="lib/PrimitiveMoveOrientation.xml"/>
    <include path="lib/PrimitiveMovePosition.xml"/>
    <include path="lib/KillController.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <Sequence name="LILTANK COMP TREE">
            <SetBlackboardV3 output_key="0" value="0"/>
            <SetBlackboardV3 output_key="60" value="60"/>
            <SetBlackboardV3 output_key="15" value="15"/>
            <SetBlackboardV3 output_key="depth" value="-2"/>
            <SubTree ID="WaitForKillSwitch"/>
            <SubTree ID="Dive" depth="{depth}"/>
            <SubTree ID="WaitForTalos" bin_heading="{bin_heading}"/>
            <RepeatV3 num_cycles="5">
                <PublishToController isOrientation="0" mode="0" name="Disable position control" x="0" y="0" z="0"/>
            </RepeatV3>
            <SubTree ID="SetClawState" claw_opened="{0}" claw_raised="{0}"/>
            <ForceSuccess>
                <SubTree ID="TableTree"/>
            </ForceSuccess>
            <Sequence name="Post Table tasks">
                <SubTree ID="PrimitiveMoveOrientation" p="{0}" r="{0}" timeout="{15}" y="{bin_heading}"/>
                <SetMappingTarget lock_map="0" name="Clear map target" target_object="" time_limit_secs="3"/>
                <SubTree ID="PrimitiveMovePosition" timeout="{60}" x="{0}" y="{0}" z="{0}"/>
                <RepeatV3 num_cycles="5">
                    <PublishToController isOrientation="0" mode="1" name="FF up" x="0" y="0" z="1"/>
                </RepeatV3>
                <Wait seconds="15"/>
                <SubTree ID="KillController"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
