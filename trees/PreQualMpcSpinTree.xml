<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <include path="lib/WaitForKillSwitch.xml"/>
    <include path="lib/Dive.xml"/>
    <include path="lib/KillController.xml"/>
    <BehaviorTree ID="BehaviorTree">
        <!-- notgroot:globals -->
        <Sequence name="globals">
            <Script code="gate_frame := 'prequal_gate_frame'; gate_offset := '1'; pole_frame := 'prequal_pole_frame'; pole_radius := '3'; spin_rate := '2.0'"/>
            <Sequence name="PREQUAL MPC SPIN">
                <SubTree ID="WaitForKillSwitch"/>
                <SetMappingTarget name="Lock the map" lock_map="1" target_object="" time_limit_secs="3"/>
                <SetStatus status="moving"/>
                <SubTree ID="Dive" depth="-1"/>
                <Sequence name="PREQUAL PATH">
                    <Info message="Spinning prequal path in the gate frame (+x toward the start, yaw 3.1415 faces the pole); only the pole position is used"/>
                    <TransformPose from_frame="{pole_frame}" name="pole in gate frame" op="0" or="0" out_x="{pole_x}" out_y="{pole_y}" out_z="{pole_z}" oy="0" to_frame="{gate_frame}" x="0" y="0" z="0"/>
                    <Math a="{gate_offset}" b="-1" operator="*" out="{neg_gate_offset}"/>
                    <AddWaypoint frame="{gate_frame}" heading="" look_x="" look_y="" look_z="" name="1 behind gate" out="{prequal_path}" path="" spin="" spin_rate="" x="{gate_offset}" y="0" yaw="3.1415" yaw_offset="" z="0"/>
                    <AddWaypoint frame="{gate_frame}" heading="" look_x="" look_y="" look_z="" name="2 through gate" out="{prequal_path}" path="{prequal_path}" spin="" spin_rate="" x="{neg_gate_offset}" y="0" yaw="3.1415" yaw_offset="" z="0"/>
                    <AddArc approach="" cx="{pole_x}" cy="{pole_y}" end_radius="" frame="{gate_frame}" heading="" look_x="" look_y="" look_z="" name="3 right of the pole, round behind it to its left, facing it" out="{prequal_path}" path="{prequal_path}" radius="{pole_radius}" spin="" spin_rate="" start_angle="1.5708" sweep="3.1416" yaw="" yaw_offset="" z="{pole_z}"/>
                    <AddWaypoint frame="{gate_frame}" heading="" look_x="" look_y="" look_z="" name="4 front of gate, nose first" out="{prequal_path}" path="{prequal_path}" spin="" spin_rate="" x="{neg_gate_offset}" y="0" yaw="" yaw_offset="" z="0"/>
                    <AddWaypoint frame="{gate_frame}" heading="" look_x="" look_y="" look_z="" name="5 back through gate" out="{prequal_path}" path="{prequal_path}" spin="" spin_rate="" x="{gate_offset}" y="0" yaw="" yaw_offset="" z="0"/>
                    <SetStatus status="performing"/>
                    <FollowPath frame="" max_depth="" min_depth="" spin_rate="{spin_rate}" timeout="300" waypoints="{prequal_path}"/>
                </Sequence>
                <SubTree ID="KillController"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>
